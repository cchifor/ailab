# PLAINTEXT SHAPE of secret.sops.yaml - this example is NOT read by kustomize and holds no secret.
#
# The Gitea PAT the watchdog uses. Scopes are the minimum the three call families need:
#   read:admin + read:organization  GET /orgs/cchifor/actions/runners (the org runners list)
#   write:repository                POST /repos/{o}/{r}/actions/runs/{id}/rerun-failed-jobs
# Mint it ONCE, in the gitea pod (PAT scopes are immutable; a wrong set means a new token):
#   kubectl --context admin@ai -n gitea exec deploy/gitea -c gitea -- \
#     gitea admin user generate-access-token --raw -u chifor -t ci-rerun-watchdog \
#       --scopes read:admin,read:organization,write:repository
# then, on the workstation with the age key (kubernetes/infra/_out/age.agekey, main checkout):
#   cp secret.sops.yaml.example secret.sops.yaml          # in kubernetes/apps/apps/ci-rerun-watchdog/
#   (paste the token over REPLACE_ME in an editor - never via a shell command that lands in history)
#   sops --encrypt --in-place secret.sops.yaml            # .sops.yaml's generic rule: data|stringData
#   verify `- secret.sops.yaml` is listed in kustomization.yaml and commit ONLY the encrypted file.
# `git diff` must show ENC[...] for `token` and nothing else in plaintext.
apiVersion: v1
kind: Secret
metadata:
  name: ci-rerun-watchdog-gitea
  namespace: ci-rerun-watchdog
type: Opaque
stringData:
  token: REPLACE_ME
