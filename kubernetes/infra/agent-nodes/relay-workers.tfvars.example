# Operator-only opt-in; see docs/runbooks/relay-worker-capacity.md first.
# Before a rollout, pass it explicitly (-var-file) so an ordinary agent-pool apply cannot provision it.
# Once the node exists, the operator's copy is relay-workers.auto.tfvars (gitignored) so EVERY
# plan/apply loads it; without it a plan would destroy the node (prevent_destroy refuses).
relay_worker_nodes = {
  relay-worker-1 = {
    node_name  = "ai-node3"
    vm_id      = 4304
    ip         = "192.168.0.52"
    host_ip    = "192.168.0.4"
    cores      = 12
    memory_mib = 24576
    disk_gb    = 200
  }
}
