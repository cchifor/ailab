machine:
  # WS2: tag the node's storage fabric so workloads that benefit from fast block I/O (e.g. Prometheus)
  # prefer the Thunderbolt nodes over the 2.5GbE/USB node via nodeAffinity.
  nodeLabels:
    node.kubernetes.io/exclude-from-external-load-balancers: "" # Talos default for control planes — keep it
    ailab.io/storage-tier: ${storage_tier}
  install:
    disk: /dev/sda
  network:
    nameservers: ${nameservers}
    interfaces:
      - deviceSelector:
          driver: virtio_net
        dhcp: false
        addresses:
          - ${node_ip}/${prefix}
        routes:
          - network: 0.0.0.0/0
            gateway: ${gateway}
          # WS2 (Thunderbolt CSI): reach the QNAP storage service IP via THIS node's Proxmox host,
          # which forwards + SNATs over the ~1.1 GB/s TB fabric. Single NIC — no passthrough, VIP and
          # default route stay put. Harmless until CSI is cut over to ${storage_service_ip} (deferred:
          # needs the host storage_router SNAT applied; see ADR 0011 + the runbook).
          - network: ${storage_service_ip}/32
            gateway: ${host_ip}
        vip:
          ip: ${vip}
  registries:
    mirrors:
      # Pull docker.io through Google's anonymous pull-through cache to dodge Docker Hub
      # rate limits (HTTP 429). No credentials needed. (followup #3)
      docker.io:
        endpoints:
          - https://mirror.gcr.io
  # Fence host capacity for kubelet + containerd + the Talos etcd HOST service so a workload memory
  # spike can't starve the colocated control plane. kube/systemReserved reduce schedulable Allocatable
  # (~31.5 -> ~28 GiB); evictionHard is kubelet-enforced. Kubelet-config change = kubelet restart (not
  # a reboot); roll one CP at a time with etcd-quorum checks. (WS3, ADR 0009)
  kubelet:
    extraConfig:
      kubeReserved:
        cpu: 500m
        memory: 1Gi
        ephemeral-storage: 1Gi
      systemReserved:
        cpu: 500m
        memory: 1Gi
        ephemeral-storage: 1Gi
      evictionHard:
        memory.available: 5%
        nodefs.available: 10%
        imagefs.available: 10%
  # Let the in-cluster talos-backup CronJob (ns talos-backup) take etcd snapshots through the Talos API
  # via a scoped talos.dev ServiceAccount — no host talosconfig secret, no cross-node :50000. Scope is
  # limited to os:etcd:backup and to the talos-backup namespace. (Backup/DR, ADR 0010.)
  features:
    kubernetesTalosAPIAccess:
      enabled: true
      allowedRoles:
        - os:etcd:backup
      allowedKubernetesNamespaces:
        - talos-backup
cluster:
  allowSchedulingOnControlPlanes: true
  network:
    cni:
      name: none
  proxy:
    disabled: true
  # Expose controller-manager + scheduler metrics on the pod network (they bind 127.0.0.1 by
  # default) so kube-prometheus-stack can scrape them. Stateless static pods → safe restart.
  # (followup #4.)
  #
  # etcd metrics (2026-09-27, #598): etcd serves /metrics on its client port behind mTLS only, so
  # nothing scraped it and the leader-lease timeouts ("etcdserver: request timed out") that restart
  # csi-nfs, agent-sandbox, kube-controller-manager and kube-scheduler had no fsync / commit-latency
  # evidence to diagnose them with. A plain-HTTP metrics listener on the NODE IP (not 0.0.0.0 — it
  # is unauthenticated) serves /metrics and /health only, no keyspace. Changing etcd args does NOT
  # restart etcd: the EtcdSpec updates live, but the process keeps its old flags until the next boot,
  # and Talos refuses `service etcd restart` ("doesn't support restart operation via API"). Roll
  # such a change with one controlled reboot per CP, `talosctl etcd status` 3/3 in-sync between.
  #
  # heartbeat-interval / election-timeout 100/1000ms (etcd defaults) -> 250/2500ms (2026-09-29).
  # Once #598's metrics existed they showed ~80 leader changes in the 41h after the 09-27 roll (21 in
  # 12h), WAL fsync p99 35-59ms with 0.5-1.7s spikes on cp1/cp2 (etcd wants ~10ms), and 200-550 failed
  # heartbeats per member. Each host's single consumer NVMe is shared by its CP VM, two or three CI
  # runners and (node1) the registry LXC; the fsync spikes line up with runner write bursts. A leader
  # whose raft loop is stuck in fsync for >1s misses heartbeats and its followers call an election:
  # every such election fails in-flight Txn/Range with Unavailable (etcdHighNumberOfFailedGRPCRequests),
  # "leader changed" (the 09-29 Velero partial failure) and lease-renewal timeouts. 250/2500 keeps
  # etcd's recommended 10x ratio and rides out stalls up to ~2.5s; the cost is that a truly dead leader
  # is replaced in ~2.5s instead of ~1s, immaterial here. Runner disk writes are also capped
  # (runners/main.tf `speed`). The real fix is a disk etcd does not share (planned, not in this change).
  # ALL THREE members must run the same values: roll per the note above, one CP at a time.
  etcd:
    extraArgs:
      listen-metrics-urls: http://${node_ip}:2381
      heartbeat-interval: "250"
      election-timeout: "2500"
  controllerManager:
    extraArgs:
      bind-address: 0.0.0.0
  scheduler:
    extraArgs:
      bind-address: 0.0.0.0
---
# etcd client + peer ports accept only the three control planes (2026-09-27). Talos ingress firewall,
# default action pinned to ACCEPT just below (so this rule's meaning cannot silently invert if a
# later change flips the default to block): the rule drops 2379-2380 from every other source and
# touches nothing else; loopback is always allowed (the apiserver reaches etcd on ::1/127.0.0.1).
# Measured before applying: the only 2379 clients were loopback, the only 2380 peers the CPs.
# Why: the etcd CA private key was exposed in an operator session transcript that day, and
# `talosctl rotate-ca` does not cover the etcd CA. This is CONTAINMENT, not a fix: source-IP
# filtering is not authentication — an on-link host that spoofs a CP address, or anything that
# egresses from a CP node with the node IP (hostNetwork pods, SNAT'd pod traffic), still passes.
# The actual remedy is a planned manual etcd CA rotation (ailab#914). :2381 (plain /metrics) is a
# different port and unaffected.
# How the rule compiles (verify after any change — rule semantics depend on the default action):
# `talosctl -n <cp> get nftableschains ingress -o yaml` shows, under `policy: accept`, a rule with
# `matchSourceAddress.includeSubnets: [<the 3 CP /32s>]`, `invert: true`, dport 2379-2380,
# `verdict: drop` — i.e. NON-CP sources are dropped, CPs fall through to accept (checked 2026-09-27;
# a review suspected the inverse). Black-box: from a non-CP host, `curl -k https://<cp>:2379` must
# time out (it did: exit 28; exit 56 = TLS refusal = the rule is NOT in effect).
apiVersion: v1alpha1
kind: NetworkDefaultActionConfig
ingress: accept
---
apiVersion: v1alpha1
kind: NetworkRuleConfig
name: etcd-ingress
portSelector:
  ports:
    - 2379-2380
  protocol: tcp
ingress:
%{ for ip in cp_ips ~}
  - subnet: ${ip}/32
%{ endfor ~}
