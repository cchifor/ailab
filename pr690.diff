new file mode 100644
index 00000000..fa93b42c
--- /dev/null
+++ b/ansible/roles/openbao_agent/handlers/main.yml
@@ -0,0 +1,20 @@
+---
+# Dropping a certificate into /usr/local/share/ca-certificates does nothing until the bundle is
+# rebuilt; there is no module for it.
+- name: Update CA trust
+  ansible.builtin.command: update-ca-certificates
+  changed_when: true
+
+# Own daemon-reload rather than a consumer's "Reload systemd": this role is imported by more than
+# one play and must not depend on a handler name another role happens to define.
+- name: Reload systemd for openbao-agent
+  ansible.builtin.systemd:
+    daemon_reload: true
+
+# Check-mode guard: a first-run --check preview never really writes the unit file, and the systemd
+# module fails on a unit it cannot find. Consumers notify this by name after importing the role.
+- name: Restart openbao-agent
+  ansible.builtin.systemd:
+    name: openbao-agent.service
+    state: restarted
+  when: not ansible_check_mode
