diff --git a/ansible/roles/pr_reviewer/tasks/openbao.yml b/ansible/roles/pr_reviewer/tasks/openbao.yml
new file mode 100644
index 00000000..86d73afc
--- /dev/null
+++ b/ansible/roles/pr_reviewer/tasks/openbao.yml
@@ -0,0 +1,118 @@
+---
+# The shared codex login on a reviewer VM (2026-09-12). The isolated LLM user's ~/.codex/auth.json
+# used to be seeded by hand from another host's copy of the same ChatGPT login — and OpenAI refresh
+# tokens are single-use, so the moment two copies both refreshed, the family was revoked estate-wide
+# (2026-09-03). Now the bao agent renders that file from the broker's OAuth document in OpenBao
+# with the refresh_token stripped: this host can use the token but never rotate it, and picks up the
+# af-codex-refresh CronJob's nightly rotation within the agent's poll interval. No `codex login`
+# here, ever again.
+#
+# Deliberately smaller than dev_worker's plumbing: no `cred` (nothing else to read — the reviewer
+# AppRole policy is this one document and nothing more), no sink readers, one template. Opt-in via
+# pr_reviewer_enable_openbao; only meaningful on the codex persona, and main.yml gates on both.
+# Cluster side: the reviewer-N AppRole + policy (devworker-provision-job.yaml) and the secret-id
+# mint (docs/runbooks/openbao-dev-workers.md (e)) — the pair lands in reviewbot.sops.yaml as
+# reviewbot_openbao_credentials.<inventory_hostname>.{role_id,secret_id}.
+- name: Install the bao agent (shared openbao_agent role)
+  ansible.builtin.import_role:
+    name: openbao_agent
+  vars:
+    openbao_agent_role_id: "{{ (reviewbot_openbao_credentials[inventory_hostname] | default({})).role_id | default('') }}"
+    openbao_agent_secret_id: "{{ (reviewbot_openbao_credentials[inventory_hostname] | default({})).secret_id | default('') }}"
+    openbao_agent_unit_description: "OpenBao agent (reviewer codex credential)"
+
+# The agent creates a missing destination directory itself — as root — and codex needs to write
+# its own sessions/config next to auth.json, so the directory has to exist user-owned first.
+# main.yml already creates it 0700 for the codex persona; repeated here so a `-t openbao` run does
+# not depend on a task its tag excludes.
+- name: Ensure the isolated codex user's ~/.codex exists
+  ansible.builtin.file:
+    path: "/home/{{ pr_reviewer_llm_sudo_user }}/.codex"
+    state: directory
+    owner: "{{ pr_reviewer_llm_sudo_user }}"
+    group: "{{ pr_reviewer_llm_sudo_user }}"
+    mode: "0700"
+
+- name: Lay down the bao agent config
+  ansible.builtin.template:
+    src: openbao-agent.hcl.j2
+    dest: /etc/openbao-agent/agent.hcl
+    owner: root
+    group: openbao-agent
+    mode: "0640"
+    backup: true # the rollback target if the post-restart health check fails
+  register: pr_reviewer_agent_hcl
+  notify: Restart openbao-agent
+
+# Skipped in check mode: with state set, the systemd module fails on a unit whose file a check run
+# never actually wrote.
+- name: Enable + start openbao-agent
+  ansible.builtin.systemd:
+    name: openbao-agent.service
+    enabled: true
+    state: started
+    daemon_reload: true
+  when: not ansible_check_mode
+
+# Handlers are queued until the END of the play, so any check written after the template task above
+# would inspect the OLD process. Flush here so the check below observes the agent running the new
+# config.
+- name: Apply the pending openbao-agent restart before verifying it
+  ansible.builtin.meta: flush_handlers
+
+# The verification and its rollback are ONE block/rescue: the rescue fires only if a task inside the
+# block fails, so the check has to live inside it.
+- name: Verify the agent, and roll this host back if it is unhealthy
+  when: not ansible_check_mode
+  block:
+    - name: Verify the agent restarted onto the new config and rendered the codex login
+      ansible.builtin.shell: |
+        set -euo pipefail
+        # 1. the RUNNING process must be newer than the config it is meant to have loaded
+        [ "$(systemctl is-active openbao-agent)" = active ] || { echo "openbao-agent not active" >&2; exit 1; }
+        started=$(date -d "$(systemctl show openbao-agent -p ExecMainStartTimestamp --value)" +%s)
+        written=$(stat -c %Y /etc/openbao-agent/agent.hcl)
+        [ "$started" -ge "$written" ] || { echo "agent started BEFORE agent.hcl was written - stale process" >&2; exit 1; }
+        # 2. still up after a settle window, i.e. not in a crash/restart loop
+        before=$(systemctl show openbao-agent -p NRestarts --value)
+        sleep 20
+        [ "$(systemctl is-active openbao-agent)" = active ] || { echo "openbao-agent died after start" >&2; exit 1; }
+        [ "$(systemctl show openbao-agent -p NRestarts --value)" = "$before" ] || { echo "openbao-agent is restart-looping" >&2; exit 1; }
+        # 3. the codex login rendered: user-owned 0600, valid JSON with an access_token that has
+        #    more than a day left and NO refresh_token (the stripping is the whole safety property).
+        f="/home/{{ pr_reviewer_llm_sudo_user }}/.codex/auth.json"
+        [ -s "$f" ] || { echo "$f not rendered" >&2; exit 1; }
+        [ "$(stat -c '%a %U' "$f")" = "600 {{ pr_reviewer_llm_sudo_user }}" ] || { echo "$f wrong mode/owner" >&2; exit 1; }
+        python3 - "$f" <<'PY' || { echo "$f is not a usable access-token-only codex login" >&2; exit 1; }
+        import base64, json, sys, time
+        d = json.load(open(sys.argv[1]))
+        t = d["tokens"]
+        assert d["auth_mode"] == "chatgpt" and t["account_id"] and t["id_token"], "shape"
+        assert t["refresh_token"] == "", "refresh_token must be stripped"
+        p = t["access_token"].split(".")[1]; p += "=" * (-len(p) % 4)
+        left = json.loads(base64.urlsafe_b64decode(p))["exp"] - time.time()
+        assert left > 24 * 3600, f"access_token has only {left/3600:.1f}h left"
+        PY
+        echo agent-healthy
+      args:
+        executable: /bin/bash
+      changed_when: false
+
+  rescue:
+    - name: Restore the previous agent config
+      ansible.builtin.shell: |
+        set -eu
+        BAK="{{ pr_reviewer_agent_hcl.backup_file | default('') }}"
+        if [ -n "$BAK" ] && [ -f "$BAK" ]; then
+          cp "$BAK" /etc/openbao-agent/agent.hcl
+          systemctl restart openbao-agent
+        fi
+      changed_when: true
+
+    - name: Fail loudly after rolling back
+      ansible.builtin.fail:
+        msg: >-
+          openbao-agent did not come up healthy on {{ inventory_hostname }}; the previous agent.hcl
+          (if any) was restored. The hand-seeded ~/.codex/auth.json is untouched until the first
+          successful render, so reviews keep running on it — fix the agent before re-running
+          (docs/runbooks/openbao-dev-workers.md, "Failure modes").
diff --git a/ansible/roles/pr_reviewer/templates/openbao-agent.hcl.j2 b/ansible/roles/pr_reviewer/templates/openbao-agent.hcl.j2
new file mode 100644
index 00000000..cb7d6b3f
--- /dev/null
+++ b/ansible/roles/pr_reviewer/templates/openbao-agent.hcl.j2
@@ -0,0 +1,41 @@
+// Managed by ansible (role: pr_reviewer). bao agent: AppRole auto-auth -> PERIODIC token (no
+// max-TTL cliff — see dev_worker's agent.hcl for the 2026-08-25 lesson), a sink for the agent's
+// own renewal, and ONE template: the shared codex login for the isolated LLM user.
+vault {
+  address = "{{ openbao_agent_addr }}"
+  ca_cert = "/usr/local/share/ca-certificates/ailab-root-ca.crt"
+}
+
+auto_auth {
+  method "approle" {
+    config = {
+      role_id_file_path   = "/etc/openbao-agent/role-id"
+      secret_id_file_path = "/etc/openbao-agent/secret-id"
+      // The secret-id has to survive reboots — nothing re-delivers it (ADR 0020).
+      remove_secret_id_file_after_reading = false
+    }
+  }
+  // Nobody reads this sink on a reviewer (no `cred` here); the agent needs a sink to run at all.
+  sink "file" {
+    config = {
+      path = "/run/openbao-agent/token"
+      mode = 0640
+    }
+  }
+}
+
+template_config {
+  // An unreachable or sealed vault makes the agent EXIT rather than leave a half-rendered or stale
+  // credential file in place; systemd (Restart=always) then retries until the vault answers.
+  exit_on_retry_failure = true
+}
+
+// The shared codex login — ACCESS-TOKEN-ONLY (codex-auth.ctmpl strips the refresh_token so this
+// host can never rotate the estate's one login). Rendered by root, handed to the LLM user.
+template {
+  source      = "/etc/openbao-agent/codex-auth.ctmpl"
+  destination = "/home/{{ pr_reviewer_llm_sudo_user }}/.codex/auth.json"
+  perms       = "0600"
+  command     = "chown {{ pr_reviewer_llm_sudo_user }}:{{ pr_reviewer_llm_sudo_user }} /home/{{ pr_reviewer_llm_sudo_user }}/.codex/auth.json"
+  error_on_missing_key = true
+}
