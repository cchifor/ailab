{#- The strive/** keepTags, shared by strive/** and the deleteReferrers canary below so the two can never drift.
    sha- builds and ailab-<digest> protect tags each keep the N most recently pushed OR those pushed within the
    window: both rules in ONE entry, which zot ORs (defaults: registry_zot_strive_keep_recent). #}
{%- macro strive_keep_tags() -%}
          "keepTags": [
            { "patterns": ["^latest$"] },
            { "patterns": ["^ailab$"] },
            { "patterns": ["^ailab-prev\\d*$"] },
            { "patterns": ["^sha-.*"], "mostRecentlyPushedCount": {{ registry_zot_strive_keep_recent }}, "pushedWithin": {{ registry_zot_strive_keep_within | to_json }} },
            { "patterns": ["^ailab-[0-9a-f]{12}([0-9a-f]{52})?$"], "mostRecentlyPushedCount": {{ registry_zot_strive_keep_recent }}, "pushedWithin": {{ registry_zot_strive_keep_within | to_json }} }
          ]
{%- endmacro %}
{
  "distSpecVersion": "1.1.0",
  "storage": {
    "rootDirectory": "{{ registry_zot_data_dir }}",
    "gc": true,
    "gcDelay": "2h",
    "gcInterval": "1h",
    "dedupe": true,
    "retention": {
      "dryRun": {{ registry_zot_retention_dry_run | bool | to_json }},
      "policies": [
{#- zot applies only the FIRST policy whose repositories glob matches a repo, so strive/ci-build/**
    must precede strive/**, where a ci- tag matches no keepTags entry and would be deleted. It must
    NOT widen to strive/ci/**: those existing repos keep their strive/** rules. #}
        {
          "repositories": ["strive/ci-build/**"],
          "deleteUntagged": true,
          "keepTags": [
            { "patterns": ["^ci-[0-9a-f]{40}$"], "mostRecentlyPushedCount": {{ registry_zot_strive_ci_build_keep_recent }}, "pushedWithin": {{ registry_zot_strive_ci_build_keep_within | to_json }} }
          ]
        },
{%- set strive_referrers_all = 'strive/**' in registry_zot_strive_delete_referrers_repos %}
{%- if registry_zot_strive_delete_referrers_repos | length > 0 and not strive_referrers_all %}
{#- deleteReferrers canary (defaults: registry_zot_strive_delete_referrers_repos): strive/**'s exact rules plus
    deleteReferrers, listed after strive/ci-build/** and before strive/**, so it claims only the listed repos.
    Widening to "strive/**" instead sets deleteReferrers on the strive/** policy itself (no canary). #}
        {
          "repositories": {{ registry_zot_strive_delete_referrers_repos | to_json }},
          "deleteUntagged": true,
          "deleteReferrers": true,
          {{ strive_keep_tags() }}
        },
{%- endif %}
        {
          "repositories": ["strive/**"],
          "deleteUntagged": true,
{%- if strive_referrers_all %}
          "deleteReferrers": true,
{%- endif %}
          {{ strive_keep_tags() }}
        },
        {
          "repositories": ["agentforge/**"],
          "deleteUntagged": true,
          "keepTags": [
            { "patterns": ["^latest$"] },
            { "patterns": ["^[0-9a-f]{40}$"], "mostRecentlyPushedCount": {{ registry_zot_agentforge_keep_recent }} },
            { "patterns": ["^[0-9a-f]{7,12}$"], "mostRecentlyPushedCount": {{ registry_zot_agentforge_keep_recent }} },
            { "patterns": ["^[0-9a-f]{7,40}$"], "mostRecentlyPulledCount": {{ registry_zot_agentforge_keep_pulled }} }
          ]
        },
        {
          "repositories": ["**"],
          "deleteUntagged": false,
          "keepTags": [{ "patterns": [".*"] }]
        }
      ]
    }
  },
  "http": {
    "address": "0.0.0.0",
    "port": "{{ registry_zot_port }}",
    "externalUrl": "https://{{ registry_zot_hostname }}",
    "tls": {
      "cert": "{{ registry_zot_config_dir }}/certs/tls.crt",
      "key": "{{ registry_zot_config_dir }}/certs/tls.key"
    },
    "auth": {
      "htpasswd": {
        "path": "{{ registry_zot_config_dir }}/htpasswd"
      }{% if registry_zot_oidc_enabled %},
      "openid": {
        "providers": {
          "{{ registry_zot_oidc_provider_key }}": {
            "name": "Authelia",
            "issuer": "{{ registry_zot_oidc_issuer }}",
            "clientid": "{{ registry_zot_oidc_client_id }}",
            "clientsecret": "{{ registry_oidc_client_secret }}",
            "keypath": "",
            "scopes": ["openid", "profile", "email", "groups"]
          }
        }
      }{% endif %}
    },
    "accessControl": {
      "repositories": {
{#- zot authorizes a repo by its LONGEST matching pattern only (policies are NOT merged), so every
    scoped entry below must repeat the base grants; the macro keeps them in one place. #}
{%- macro base_policies() %}
            {
              "users": ["{{ registry_zot_ci_user }}"],
              "actions": ["read", "create", "update", "delete"]
            },
            {
              "users": ["{{ registry_zot_pull_user }}"],
              "actions": ["read"]
            }{% if registry_zot_admin_group %},
            {
              "groups": ["{{ registry_zot_admin_group }}"],
              "actions": ["read", "create", "update", "delete"]
            }{% endif %}
{%- endmacro %}
        "**": {
          "anonymousPolicy": ["read"],
          "policies": [{{ base_policies() }}
          ]
        }{% for p in registry_zot_scoped_push_users %},
        {{ p.repositories | to_json }}: {
          "anonymousPolicy": ["read"],
          "policies": [{{ base_policies() }},
            {
              "users": [{{ p.user | to_json }}],
              "actions": ["read", "create", "update"]
            }
          ]
        }{% endfor %}
      }{% if registry_zot_admin_group %},
      "adminPolicy": {
        "groups": ["{{ registry_zot_admin_group }}"],
        "actions": ["read", "create", "update", "delete"]
      }{% endif %}
    }
  },
  "log": {
    "level": "info"
  },
  "extensions": {
    "search": {
      "enable": true
    },
    "ui": {
      "enable": true
    },
    "sync": {
      "enable": true,
{% if registry_zot_sync_dockerhub_user | length > 0 %}
      "credentialsFile": "{{ registry_zot_sync_credentials_file }}",
{% endif %}
      "registries": [
        {
          "urls": ["https://quay.io"],
          "onDemand": true,
          "tlsVerify": true,
          "content": [{ "prefix": "keycloak/**" }]
        },
        {
          "urls": ["https://mcr.microsoft.com"],
          "onDemand": true,
          "tlsVerify": true,
          "content": [{ "prefix": "playwright" }, { "prefix": "playwright/**" }]
        },
        {
          "urls": ["https://mirror.gcr.io", "https://registry-1.docker.io"],
          "onDemand": true,
          "tlsVerify": true,
          "content": [{% for p in registry_zot_sync_dockerhub_prefixes %}{ "prefix": {{ p | to_json }} }{% if not loop.last %}, {% endif %}{% endfor %}]
        }
      ]
    }
  }
}
