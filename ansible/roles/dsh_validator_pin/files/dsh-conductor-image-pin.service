[Unit]
Description=Retain the checksum-pinned DSH validator image without running validation
Requires=docker.service
After=docker.service

[Service]
# A plain oneshot so the timer can re-run it; `systemctl is-active` is therefore NOT the health
# signal - the container is (docs/runbooks/dsh.md).
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/libexec/dsh-conductor-image-pin.py
TimeoutStartSec=600
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
