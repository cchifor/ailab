[Unit]
Description=Publish reviewer Codex access token to OpenBao for DSH
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/lib/dsh-codex-publisher/publish.py
User=root
UMask=0077
StateDirectory=dsh-codex-publisher
StateDirectoryMode=0700
NoNewPrivileges=true
ProtectSystem=strict
# The freshness metrics land in node_exporter's textfile directory (ADR 0026); everything else stays
# read-only.
ReadWritePaths=/var/lib/prometheus/node-exporter
ProtectHome=read-only
PrivateTmp=true
RestrictAddressFamilies=AF_INET AF_INET6
# Sized from the projection list: each projection is three 20 s HTTP operations (login,
# metadata, patch), so 60 s x N + 30 s of slack; a third projection cannot be SIGKILLed mid-run
# by a budget written for two (#792 review). Rendered by the role from dsh_codex_publisher.
TimeoutStartSec={{ 60 * (dsh_codex_publisher.projections | mandatory('dsh_codex_publisher.projections must be set in host_vars: the start budget is sized from it, and an empty default would render a 30 s budget that kills every run') | length) + 30 }}
