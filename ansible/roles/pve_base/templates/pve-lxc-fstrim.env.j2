# Managed by ansible (role: pve_base, tag lxc_fstrim). Read by /usr/local/sbin/pve-lxc-fstrim; the
# settings without the PVE_LXC_FSTRIM_ prefix are lxc-fstrim-chunked.sh's own (it inherits them).
PVE_LXC_FSTRIM_STORAGES="{{ pve_lxc_fstrim_storages | join(' ') }}"
PVE_LXC_FSTRIM_EXCLUDE="{{ pve_lxc_fstrim_exclude | join(' ') }}"
PVE_LXC_FSTRIM_RUN_MAX_S={{ (pve_lxc_fstrim_run_max_min | int) * 60 }}
PVE_LXC_FSTRIM_TEXTFILE_DIR={{ pve_lxc_fstrim_textfile_dir }}
CHUNK_GB={{ pve_lxc_fstrim_chunk_gb | int }}
PAUSE_S={{ pve_lxc_fstrim_pause_s | int }}
PAUSE_IDLE_S={{ pve_lxc_fstrim_pause_idle_s | int }}
SEC_PER_GB={{ pve_lxc_fstrim_sec_per_gb | int }}
PSI_MAX={{ pve_lxc_fstrim_psi_max }}
PSI_WAIT_MAX_S={{ pve_lxc_fstrim_psi_wait_max_s | int }}
