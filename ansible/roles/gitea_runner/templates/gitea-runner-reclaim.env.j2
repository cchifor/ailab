# MANAGED BY ANSIBLE (role: gitea_runner). Sourced by /usr/local/bin/gitea-runner-reclaim.sh (both the
# ExecStartPre of {{ gitea_runner_service }} and the gitea-runner-reclaim.timer). Plain shell KEY=VALUE.
GITEA_RUNNER_SERVICE={{ gitea_runner_service }}
GITEA_RUNNER_WORKDIR_PARENT={{ gitea_runner_workdir_parent }}
GITEA_RUNNER_USER={{ gitea_runner_user }}
GITEA_RUNNER_GROUP={{ gitea_runner_group }}
GITEA_RUNNER_CONFIG_DIR={{ gitea_runner_config_dir }}
# Space-separated artifact subdirs to reclaim. KEEP IN SYNC with the platform job-started hook.
GITEA_RECLAIM_DIRS="{{ gitea_runner_reclaim_dirs | join(' ') }}"
GITEA_RECLAIM_BEACON={{ gitea_runner_reclaim_beacon | bool | ternary('1', '0') }}
GITEA_RECLAIM_TEXTFILE_DIR={{ gitea_runner_reclaim_textfile_dir }}
# ---- job-boundary leftover reaper (gitea-runner-reap.py; also reads this file) ----
GITEA_REAP_MODE={{ gitea_runner_reap_mode }}
GITEA_REAP_BIN={{ gitea_runner_reap_bin }}
GITEA_REAP_STATE={{ gitea_runner_reap_state }}
GITEA_REAP_MARGIN_SEC={{ gitea_runner_reap_margin_sec }}
GITEA_REAP_GRACE_SEC={{ gitea_runner_reap_grace_sec }}
GITEA_REAP_PERIODIC_SEC={{ gitea_runner_reap_periodic_sec }}
GITEA_REAP_MAX_PROCS={{ gitea_runner_reap_max_procs }}
GITEA_REAP_KEEP_LABEL_RE="{{ gitea_runner_reap_keep_label_re }}"
GITEA_RUNNER_JOB_TIMEOUT={{ gitea_runner_job_timeout }}
# The SAME exemptions as gitea-runner-cleanup.sh (rendered from the same role vars), so ci-runner-1's
# dsh image-pin regex and the cloud runners' `none` peer sentinel apply to the reaper too.
GITEA_CLEANUP_INFRA_EXCLUDE_RE="{{ gitea_runner_cleanup_infra_exclude_re }}"
GITEA_CLEANUP_PEER_SERVICES="{{ gitea_runner_cleanup_peer_services }}"
# Shared-cache purge queue (gitea-runner-cache-verify.py apply), applied only where no job can be
# using the entries: the reclaim's ExecStartPre and the cleanup's confirmed idle window.
GITEA_CACHE_VERIFY_BIN={{ gitea_runner_cache_verify_bin }}
GITEA_CACHE_PURGE_QUEUE={{ gitea_runner_cache_verify_queue }}
