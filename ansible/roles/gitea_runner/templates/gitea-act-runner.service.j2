# MANAGED BY ANSIBLE (role: gitea_runner). Persistent act_runner daemon (HOST mode) for Gitea Actions.
# Unlike the GitHub runner (one ephemeral --replace cycle per job via ephemeral-runner.sh), act_runner
# is a long-running daemon that polls Gitea and executes up to `runner.capacity` jobs (config.yaml).
[Unit]
Description=Gitea Actions runner (act_runner, host mode)
After=network-online.target docker.service
Wants=network-online.target
# StartLimit* live in [Unit] on systemd >= 229 (Ubuntu 24.04); in [Service] they warn + are ignored.
StartLimitIntervalSec=0

[Service]
Type=simple
User={{ gitea_runner_user }}
WorkingDirectory={{ gitea_runner_config_dir }}
{% if gitea_runner_reclaim_enabled | bool %}
# Race-free clean slate on every (re)start: reclaim reused host-mode workspaces BEFORE the daemon
# starts polling, so no job can be in flight. The '+' prefix runs it as root (User= above is runner),
# which is required to delete root-owned leftovers. act_runner has no per-job hook, so the between-jobs
# case is handled by gitea-runner-reclaim.timer. Best-effort (the script always exits 0).
ExecStartPre=+{{ gitea_runner_reclaim_bin }}
{% endif %}
ExecStart={{ gitea_runner_bin }} daemon --config {{ gitea_runner_config_dir }}/config.yaml
Restart=always
RestartSec=10
# Startup budget (covers ExecStartPre). systemd's default 90s killed the reclaim mid-scan when the
# workspace count ballooned (2026-07-28: O(workspaces x processes) /proc scan at ~400 workspaces), and
# Restart=always turned that into a permanent restart loop with the whole fleet offline. The scan is
# single-pass now (see gitea-runner-reclaim.sh); this headroom keeps a slow disk or a big post-incident
# chown-heal from ever wedging the daemon the same way again.
TimeoutStartSec=10min
# KillMode=mixed, NOT control-group — this is what makes runner.shutdown_timeout mean anything.
# In HOST mode a job's processes are children of this daemon and live in THIS unit's cgroup. Under
# control-group (systemd's default, and what this unit shipped until ailab#745 review) the stop
# sequence SIGTERMs EVERY process in the cgroup at once — act_runner AND the running job's whole
# process tree — so act_runner would sit out its entire drain window waiting for a job systemd had
# already killed. `mixed` sends the stop signal to the MAIN process only, leaving the job's children
# untouched so they can actually finish.
KillMode=mixed
KillSignal=SIGTERM
# The SIGKILL backstop is unaffected by the above: at TimeoutStopSec systemd still sends
# FinalKillSignal to EVERY remaining process in the cgroup, so a wedged job cannot outlive the stop.
# TimeoutStopSec MUST exceed runner.shutdown_timeout in config.yaml, or that SIGKILL lands while
# act_runner is still draining and reintroduces exactly the zero-log-line failure shutdown_timeout
# exists to prevent. It is DERIVED rather than written literally: both values come from
# gitea_runner_shutdown_timeout_min ({{ gitea_runner_shutdown_timeout_min }}), so the +1min buffer
# holds for any override. A hardcoded literal here silently broke that invariant the moment anyone
# raised the drain budget (ailab#745 review).
TimeoutStopSec={{ gitea_runner_shutdown_timeout_min + 1 }}min

# Resource caps bound the daemon AND its host-mode job children (they run in this unit's cgroup).
# During co-location the GitHub runner is capped at 10G; keep the SUM under the VM's 24 GiB. See the
# defaults + the forge-migration ADR for the double-heavyweight OOM caveat (concurrency is per-forge).
CPUQuota={{ gitea_runner_cpu_quota }}
CPUWeight=80
IOWeight=80
MemoryMax={{ gitea_runner_memory_max }}
MemoryHigh={{ gitea_runner_memory_high }}
TasksMax={{ gitea_runner_tasks_max }}

[Install]
WantedBy=multi-user.target
