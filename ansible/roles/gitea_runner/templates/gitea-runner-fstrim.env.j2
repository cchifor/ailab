# MANAGED BY ANSIBLE (role: gitea_runner). Sourced by {{ gitea_runner_fstrim_bin }} (the
# gitea-runner-fstrim.timer oneshot). Plain shell KEY=VALUE. Every value here is a role var.
# The act_runner unit whose MainPID children mean "a job is running" (the cleanup's busy signal).
GITEA_RUNNER_SERVICE={{ gitea_runner_service }}
# Night window, HH:MM UTC (END exclusive; END < START wraps midnight). Staggered per host in host_vars:
# runners on one Proxmox node share its NVMe with etcd, so they must not trim at the same time.
GITEA_FSTRIM_WINDOW_START="{{ gitea_runner_fstrim_window_start }}"
GITEA_FSTRIM_WINDOW_END="{{ gitea_runner_fstrim_window_end }}"
# Weekdays the window may run, by the day it STARTS (1-7 = Mon-Sun, or mon..sun). ci-runner-9 skips Sunday,
# when ai-node1's registry LXC trim runs for an unbounded time from 03:30.
GITEA_FSTRIM_DAYS="{{ gitea_runner_fstrim_days | join(' ') }}"
# GiB per slice (rounded up to whole ext4 block groups), GiB of the filesystem covered per run, seconds
# between slices, and the longest single wait for a job to finish before giving up until the next night.
GITEA_FSTRIM_CHUNK_GB={{ gitea_runner_fstrim_chunk_gb }}
GITEA_FSTRIM_MAX_GB_PER_RUN={{ gitea_runner_fstrim_max_gb_per_run }}
GITEA_FSTRIM_PAUSE_S={{ gitea_runner_fstrim_pause_s }}
GITEA_FSTRIM_BUSY_WAIT_MAX_S={{ gitea_runner_fstrim_busy_wait_max_s }}
GITEA_FSTRIM_TEXTFILE_DIR={{ gitea_runner_reclaim_textfile_dir }}
