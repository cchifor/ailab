# {{ ansible_managed }} — reviewbot ({{ pr_reviewer_persona }} persona).
# Runs as the agent user (Phase 1; a dedicated per-persona user is Phase 2 hardening —
# the LLM subprocess needs the user's claude subscription auth in ~/.claude).
[Unit]
Description=reviewbot — LLM PR reviewer ({{ pr_reviewer_persona }})
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ pr_reviewer_user }}
Group={{ pr_reviewer_user }}
Environment=HOME=/home/{{ pr_reviewer_user }}
Environment=PATH=/home/{{ pr_reviewer_user }}/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 /usr/local/lib/reviewbot/reviewbot.py /etc/reviewbot/config.json
Restart=always
RestartSec=10
MemoryMax=2G
{% if not pr_reviewer_llm_sudo_user and (pr_reviewer_llm_seats | map(attribute='sudo_user') | select() | list | length == 0) %}
# NoNewPrivileges is incompatible with the sudo-based LLM isolation (it blocked every
# codex run on reviewer-2, caught live 2026-09-02); it stays on where sudo is unused.
# The SERVED seats' users are in the condition for the same reason: a seat list is ALSO a
# sudo user, and once Phase 2 moved the users there and cleared pr_reviewer_llm_sudo_user,
# a sudo_user-only test would render NoNewPrivileges=true and break every seat at once -
# the isolated mktemp fails first, so every job dies burning attempts. A seat with an empty
# sudo_user (a router seat: one HTTPS call as the service user) needs no sudo, so a host
# that serves router seats only gets NoNewPrivileges back (2026-10-26). Staged seats are
# never run by reviewbot and do not count.
NoNewPrivileges=true
{% endif %}

[Install]
WantedBy=multi-user.target
