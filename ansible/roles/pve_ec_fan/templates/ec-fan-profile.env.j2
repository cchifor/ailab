# Managed by ansible (role: pve_ec_fan). Read by ec-fan-profile.service. Change the curve in the role
# vars (pve_ec_fan_*), not here: the next converge rewrites this file and restarts the service.
EC_FAN_SYSFS={{ pve_ec_fan_sysfs }}
EC_FAN_FANS="{{ pve_ec_fan_fans | join(' ') }}"
EC_FAN_RAMPUP_CURVE={{ pve_ec_fan_rampup_curve | join(',') }}
EC_FAN_RAMPDOWN_CURVE={{ pve_ec_fan_rampdown_curve | join(',') }}
