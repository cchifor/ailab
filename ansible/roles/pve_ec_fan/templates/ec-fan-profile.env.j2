# Managed by ansible (role: pve_ec_fan). Read by ec-fan-profile.service and ec-fan-governor.service. Change the
# curve and the governor in the role vars (pve_ec_fan_*), not here: the next converge rewrites this file and
# restarts both.
EC_FAN_SYSFS={{ pve_ec_fan_sysfs }}
EC_FAN_FANS="{{ pve_ec_fan_fans | join(' ') }}"
EC_FAN_RAMPUP_CURVE={{ pve_ec_fan_rampup_curve | join(',') }}
EC_FAN_RAMPDOWN_CURVE={{ pve_ec_fan_rampdown_curve | join(',') }}
EC_FAN_POWER_MODE={{ pve_ec_fan_power_mode }}
EC_FAN_GOV_UP={{ pve_ec_fan_governor_up | join(',') }}
EC_FAN_GOV_DOWN={{ pve_ec_fan_governor_down | join(',') }}
EC_FAN_GOV_TAU_S={{ pve_ec_fan_governor_tau_s }}
EC_FAN_GOV_HOLD_S={{ pve_ec_fan_governor_hold_s }}
