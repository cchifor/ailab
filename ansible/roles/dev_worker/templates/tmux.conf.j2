# {{ ansible_managed }} (role: dev_worker)
# ── core ───────────────────────────────────────────────────────────────
set -g mouse on
set -g history-limit 100000
set -g base-index 1
setw -g pane-base-index 1
set -g renumber-windows on
set -g focus-events on
set -sg escape-time 10
set -g default-terminal "tmux-256color"
set -ga terminal-overrides ",xterm-256color:Tc"

# ── window size follows the real terminal (Relay connector, dev-worker-3 2026-10-04) ──
# relay-connector attaches as a control client with ignore-size and implements the browser's
# "Fit pane" with `resize-window -x -y`. tmux then sets that SESSION's window-size to `manual` and
# never resets it. Every window in the session keeps a fixed size, and a terminal that is bigger is
# filled with dots. (Connector 0.2.2 and 0.3.1 both do this.) These hooks clear the session's
# override whenever a REAL client attaches, resizes, gains focus or switches session. tmux then
# falls back to `latest` and the window follows the terminal. Control clients are excluded, so
# Fit pane still works while only the browser is viewing.
# Lines between the markers are executed verbatim by tests/test-tmux-window-size.sh.
# BEGIN window-size-follows-terminal
set -g window-size latest
set-hook -g client-attached        'if-shell -F "#{?client_control_mode,0,1}" "set-option -u window-size"'
set-hook -g client-resized         'if-shell -F "#{?client_control_mode,0,1}" "set-option -u window-size"'
set-hook -g client-focus-in        'if-shell -F "#{?client_control_mode,0,1}" "set-option -u window-size"'
set-hook -g client-session-changed 'if-shell -F "#{?client_control_mode,0,1}" "set-option -u window-size"'
# END window-size-follows-terminal

# vi-style copy mode
setw -g mode-keys vi
bind-key -T copy-mode-vi v send-keys -X begin-selection
bind-key -T copy-mode-vi y send-keys -X copy-selection-and-cancel

# ── pane / window keys ─────────────────────────────────────────────────
bind | split-window -h -c "#{pane_current_path}"
bind - split-window -v -c "#{pane_current_path}"
bind c new-window      -c "#{pane_current_path}"
bind h select-pane -L
bind j select-pane -D
bind k select-pane -U
bind l select-pane -R
bind -r H resize-pane -L 5
bind -r J resize-pane -D 5
bind -r K resize-pane -U 5
bind -r L resize-pane -R 5
bind r source-file ~/.tmux.conf \; display "tmux.conf reloaded"

# ── status bar (high-contrast, designed for pure-black terminal bg) ────
set -g status-interval 5
set -g status-position bottom
set -g status-justify left
set -g status-style "bg=#3a3a3a,fg=#e4e4e4"
set -g status-left-length 40
set -g status-right-length 120
set -g status-left  "#[fg=#5fd7ff,bold] #h #[fg=#767676]│#[fg=#5fff5f,bold] #S #[fg=#767676]│ "
set -g status-right "#[fg=#ffff5f]load:#(cut -d' ' -f1-3 /proc/loadavg) #[fg=#767676]│#[fg=#ffffff,bold] %a %H:%M "
setw -g window-status-current-style "fg=#000000,bg=#ffd700,bold"
setw -g window-status-current-format " #I:#W "
setw -g window-status-style          "fg=#b0b0b0"
setw -g window-status-format         " #I:#W "
set -g pane-border-style        "fg=#5f5f5f"
set -g pane-active-border-style "fg=#5fd7ff"
set -g message-style            "fg=#000000,bg=#ffd700,bold"

# Terminal title = "<host> [<user>@<ip>] <session>:<window>". The [user@ip] marker is what the
# workstation paste helpers (scripts/dw-paste/) read to know which worker a terminal window is
# attached to, so Ctrl+Shift+V can upload a clipboard image there. Keep the marker's shape.
# #{client_user} (tmux >= 3.2) is rendered per attached client: each user's title names that user,
# whose /workspace/<user>/pastes is where their agents can read the upload.
set -g set-titles on
set -g set-titles-string "#h [#{client_user}@{{ ansible_default_ipv4.address }}] #S:#W"

# Click on the left status segment (hostname / session name) → flat session picker.
bind -n MouseDown1StatusLeft run-shell "/usr/local/bin/tmux-session-menu"
{% if dev_worker_tmux_persistence | bool %}

# ── persistence (resurrect + continuum via TPM) — survive reboots ──────
# Plugin declarations must precede `run tpm`. @continuum-restore auto-restores the last save when
# the tmux server starts (dashboard.service at boot, or first attach); resurrect keeps pane contents.
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'
set -g @resurrect-capture-pane-contents 'on'
set -g @continuum-restore 'on'
# Keep the claude-dashboard session OUT of every snapshot. It is rebuilt from code at each boot, and
# resurrect's restore renames windows by INDEX — so a snapshot whose window list has drifted relabels
# the launcher's freshly-built dashboard, permanently (dev-worker-4 lost `home` this way for two
# weeks). post-save-layout is the only hook handed the snapshot path AND run before `last` is
# repointed at it. See files/tmux-resurrect-filter.sh; pinned by tests/test-tmux-persistence.sh.
set -g @resurrect-hook-post-save-layout '/usr/local/bin/tmux-resurrect-filter'
set -g @continuum-save-interval '{{ dev_worker_tmux_continuum_save_interval }}'
run '~/.tmux/plugins/tpm/tpm'
{% endif %}
