# Managed by Ansible (dev_worker role, templates/herdr-config.toml.j2) — local edits are overwritten
# on the next run. Everything not pinned here rides the upstream defaults on purpose: herdr is
# pre-1.0 and chasing its config surface across releases is not worth it for a pilot.

[experimental]
# Off is the upstream default, pinned deliberately: persisted pane history writes agent scrollback —
# which can carry tokens and secrets — to disk as session-history.json.
pane_history = false

[session]
# On is the upstream default, pinned because it IS the pilot: integrated agents (claude/codex)
# resume their conversations via native session ids after a server restart.
resume_agents_on_restore = true
