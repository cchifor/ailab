# Managed by ansible (role: dev_worker, tag fstrim). This worker's nightly slot (dev_worker_fstrim_start, UTC).
# A missed night is skipped, never run late into the day (Persistent=false).
[Unit]
Description=Daily trim of {{ dev_worker_fstrim_mounts | join(' and ') }}, {{ dev_worker_fstrim_start }} UTC

[Timer]
OnCalendar=*-*-* {{ dev_worker_fstrim_start }}:00 UTC
AccuracySec=1s
Persistent=false

[Install]
WantedBy=timers.target
