# {{ ansible_managed }} (role: dev_worker)
# Agent temp files off the 40 GB root disk (plans/2026-10-09-dev-worker-disk-hardening-plan.md W4):
# TMPDIR = {{ dev_worker_workspace_mount }}/<user>/.tmp, honoured by pytest, node, Python's tempfile,
# Claude Code's task output and most build tools; aged after 8h like /tmp (tasks/agent_dirs.yml).
# Sourced by login shells (/etc/profile.d) and, from ~/.bashrc, by tmux/ttyd panes, which are NOT
# login shells. Only when that directory exists, is a real directory and is writable: a TMPDIR that
# does not exist breaks mktemp, so otherwise the system /tmp stays. Caches need no variable: ~/.cache
# and ~/.npm are symlinks onto the same disk.
__dw_tmp="{{ dev_worker_workspace_mount }}/${USER:-$(id -un)}/.tmp"
if [ -d "$__dw_tmp" ] && [ ! -L "$__dw_tmp" ] && [ -w "$__dw_tmp" ]; then
	export TMPDIR="$__dw_tmp"
fi
unset __dw_tmp
