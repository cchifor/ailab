#!/bin/sh
# Managed by ansible (role: dev_worker, tasks/git_credential_helper.yml). A git credential helper
# that READS ~/.git-credentials and never writes it.
#
# The file has one owner: the OpenBao agent renders it from af/dev-workers/common (ADR 0020), or on
# the SOPS path Ansible writes it. git's stock `store` helper is a third writer. It runs `erase` on
# every 401 and `store` on every success, and the erase is the problem: Gitea answers 401 for a VALID
# token when its own database is unreachable, so a few minutes of infra-pg downtime deleted
# dev-worker-3's only credential on 2026-10-09. git had nothing to send even after Gitea recovered,
# until the OpenBao agent's next periodic render put the line back, and the agent on the box stopped
# to ask for a credential refresh. Answering only `get` turns the same outage into failed requests
# that succeed on retry. A token that really is bad gets fixed in OpenBao and
# re-rendered from there, which deleting it here never did.
case "${1:-}" in
  get) exec git credential-store get ;;
  # store / erase: read what git sends so it never writes into a closed pipe, and change nothing.
  *) cat >/dev/null ;;
esac
