#!/bin/sh
# Managed by ansible (role: dev_worker, tasks/git_credential_helper.yml). A git credential helper
# that READS ~/.git-credentials and never writes it.
#
# The file has one owner: the OpenBao agent renders it from af/dev-workers/common (ADR 0020), or on
# the SOPS path Ansible writes it. git's stock `store` helper was a third writer. When a server
# answers 401 to the credential git sent, git runs `erase` for it, and `store` erases the line. Gitea
# answers 401 to a VALID token while its own database is unreachable, so a few minutes of infra-pg
# downtime deleted dev-worker-3's only credential on 2026-10-09: git had nothing to send even after
# Gitea recovered, until the OpenBao agent's next periodic render put the line back, and the agent
# on the box stopped to ask for a credential refresh. Answering only `get` keeps the credential, so
# attempts after Gitea recovers authenticate again. A token that really is bad is fixed where the file
# comes from (OpenBao, or dev_worker_gitea_token on the SOPS path), which deleting it here never did.
#
# --file: only the managed file, not stock store's fallback to ~/.config/git/credentials.
case "${1:-}" in
  get) exec git credential-store --file "$HOME/.git-credentials" get ;;
  # store / erase: read what git sends so it never writes into a closed pipe, and change nothing.
  *) cat >/dev/null ;;
esac
