#!/usr/bin/env python3
"""cleanup — reclaim disk and memory on a dev-worker, safely.

Shows a table of exactly what it will remove, asks yes/no, then removes exactly that (by ID).

  cleanup                 show the plan, ask, then remove
  cleanup --y             no question (also -y / --yes)
  cleanup --dry-run       show the plan only
  cleanup --caches        also empty tool caches (npm, uv, old Playwright browsers)
  cleanup --stale-days 7  treat stacks idle for 7+ days as stale (default 14)
  sudo cleanup --deps     also remove dependency dirs in idle git worktrees (needs root)
  sudo cleanup --worktrees  also remove whole linked worktrees that are clean and merged/stale
  cleanup --no-docker     skip every docker category (with --deps/--worktrees: only those)

Removed by default:
  * stale compose stacks: nothing in the stack created or started for --stale-days, or its
    compose working directory no longer exists (worktree deleted). Named volumes go with the
    stack only when it is orphaned, or with --volumes.
  * stopped containers finished more than --stopped-hours ago (default 24) that are NOT part
    of a stack with running containers (those are a live stack's one-shot jobs).
  * images older than --image-days (default 7) that no surviving container uses.
  * anonymous volumes no container uses.
  * build cache beyond the newest --cache-keep-gb (default 10 GB), least recently used first.
    (Not an age filter: `buildx prune --filter until=` removes nothing on buildx 0.37.)
Opt-in (--caches): emptying these under a running `npm ci` / `uv sync` breaks that run.
Opt-in (--deps, root only): node_modules, .venv (with pyvenv.cfg) and Rust target (beside a
  Cargo.toml) inside git worktrees under /workspace and /home that nothing has touched for
  --deps-days (default 14) and no process or running container is using. Only those dirs:
  never source, git state or untracked files. The dev-worker-deps-prune timer runs it daily.
Opt-in (--worktrees, root only): whole LINKED worktrees (never a main clone) with no changes, no
  untracked files and only regenerable ignored files, that nothing is using, and that are either
  merged into a network remote's default branch (squash merges included) and idle --merged-days
  (default 3), or idle --worktree-days (default 30) with HEAD on a network remote's branch.
  `git worktree remove` without --force, run as the owner; branch refs stay, the worktree's HEAD
  reflog goes. Worktrees idle that long but not safe are listed as "Kept", with why.

Installed by ansible (roles/dev_worker, tasks/cleanup.yml); source of truth is the ailab repo.
"""
import argparse
import json
import os
import re
import shutil
import stat
import subprocess
import sys
from dataclasses import dataclass, field
from datetime import datetime, timedelta, timezone

PROJECT = "com.docker.compose.project"
WORKDIR = "com.docker.compose.project.working_dir"
ANON_VOLUME = re.compile(r"^[0-9a-f]{64}$")


# ----------------------------------------------------------------------------- model

@dataclass(frozen=True)
class Container:
    id: str
    name: str
    image_id: str
    labels: dict
    running: bool
    created: datetime
    started: datetime | None
    finished: datetime | None
    mounts: tuple = ()          # volume names
    restart_count: int = 0      # restarts by the restart policy since the last manual start


@dataclass(frozen=True)
class Image:
    id: str
    tags: tuple
    created: datetime
    size: int


@dataclass(frozen=True)
class Volume:
    name: str
    labels: dict
    size: int


@dataclass(frozen=True)
class CacheItem:
    name: str
    path: str
    size: int
    command: list
    exact: bool = True          # False: `size` is the whole cache, the command frees part of it


@dataclass
class Options:
    stale_days: int
    stopped_hours: int
    image_days: int
    cache_keep_gb: int
    keep_stacks: bool
    volumes: bool
    caches: bool


@dataclass
class Action:
    kind: str                   # stack | container | image | volume | buildcache | cache | deps
                                # | worktree
    label: str
    detail: str
    age: str
    size: int | None            # bytes; None = unknown
    ids: list = field(default_factory=list)
    command: list | None = None
    fingerprint: frozenset | None = None   # stacks: {(id, started, finished)} at scan time


CATEGORY = {
    "stack": "Stale compose stack",
    "container": "Stopped container",
    "image": "Unused image",
    "volume": "Unused volume",
    "buildcache": "Build cache",
    "cache": "Tool cache (--caches)",
    "deps": "Idle worktree deps",
    "worktree": "Stale worktree",
}


# ----------------------------------------------------------------------------- helpers

_UNITS = {"B": 1, "KB": 10**3, "MB": 10**6, "GB": 10**9, "TB": 10**12,
          "KIB": 2**10, "MIB": 2**20, "GIB": 2**30, "TIB": 2**40}


def parse_size(text):
    """Docker's human sizes ("575.5MB*", "12.5kB", "97B") -> bytes."""
    m = re.match(r"^\s*([\d.]+)\s*([A-Za-z]*)", text or "")
    if not m:
        return 0
    return int(round(float(m.group(1)) * _UNITS.get((m.group(2) or "B").upper(), 1)))


def parse_time(text):
    """RFC3339 (inspect) or 'YYYY-mm-dd HH:MM:SS.nnn +0000 UTC' (buildx/df) -> aware datetime."""
    if not text or text.startswith("0001-01-01"):
        return None
    t = text.strip().replace(" UTC", "").replace("Z", "+00:00")
    t = re.sub(r"^(\S+) (\S+) ([+-]\d{2})(\d{2})$", r"\1T\2\3:\4", t)
    t = re.sub(r"(\.\d{6})\d+", r"\1", t)
    try:
        return datetime.fromisoformat(t)
    except ValueError:
        return None


def fmt_age(delta):
    days = delta.days
    if days >= 7:
        w, d = divmod(days, 7)
        return f"{w}w{d}d" if d else f"{w}w"
    if days >= 1:
        return f"{days}d"
    return f"{max(int(delta.total_seconds() // 3600), 0)}h"


def fmt_size(n):
    if n is None:
        return "?"
    for unit in ("B", "kB", "MB", "GB", "TB"):
        if abs(n) < 1000 or unit == "TB":
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1000
    return f"{n:.1f} TB"


def confirm(yes, interactive, ask):
    """--y wins; otherwise only an interactive 'y'/'yes' proceeds."""
    if yes:
        return True
    if not interactive:
        return False
    return ask().strip().lower() in ("y", "yes")


# ----------------------------------------------------------------------------- planning

BOOT_GRACE = timedelta(minutes=15)


def activity(c, boot_times):
    """When someone last touched this container: created, or started — but a start within
    BOOT_GRACE of ANY boot is the daemon's restart policy after a reboot, not a person or an
    agent. Every boot counts, not only the current one: a stopped container keeps the StartedAt
    of the boot that last restarted it (seen live on dev-worker-3: stale workers stamped by the
    2026-09-11 reboot). The window is symmetric because docker can stamp the start slightly
    before the computed boot time when the clock is stepped during boot."""
    started, finished = c.started, c.finished
    if c.restart_count > 0:
        # The daemon's restart policy restarted it (a crash loop, seen live: 2137 restarts in
        # 3 weeks on dev-worker-4), so neither StartedAt nor FinishedAt says anyone used it.
        started = finished = None

    def near_boot(t):
        # Also catches the stop a shutdown causes: it lands just before the next boot.
        return any(abs(t - b) <= BOOT_GRACE for b in boot_times or ())

    if started and near_boot(started):
        started = None
    if finished and near_boot(finished):
        finished = None
    return max(t for t in (c.created, started, finished) if t)


def build_plan(containers, images, volumes, build_cache_bytes, tool_caches, opts, now,
               dir_exists=os.path.isdir, boot_times=()):
    plan = []
    removed = set()

    # stacks
    stacks = {}
    for c in containers:
        if c.labels.get(PROJECT):
            stacks.setdefault(c.labels[PROJECT], []).append(c)
    stale_projects = set()
    orphaned_projects = set()
    if not opts.keep_stacks:
        for proj, cs in sorted(stacks.items()):
            touched = max(activity(c, boot_times) for c in cs)
            workdir = next((c.labels.get(WORKDIR) for c in cs if c.labels.get(WORKDIR)), "")
            orphaned = bool(workdir) and not dir_exists(workdir)
            stale = now - touched > timedelta(days=opts.stale_days)
            if not (stale or orphaned):
                continue
            running = sum(c.running for c in cs)
            why = "worktree gone" if orphaned else f"idle > {opts.stale_days}d"
            plan.append(Action("stack", proj, f"{len(cs)} ctr ({running} running), {why}: {workdir}",
                               fmt_age(now - touched), None, [c.id for c in cs],
                               fingerprint=frozenset((c.id, c.started, c.finished) for c in cs)))
            removed.update(c.id for c in cs)
            stale_projects.add(proj)
            if orphaned:
                orphaned_projects.add(proj)
            elif opts.volumes:
                orphaned_projects.add(proj)  # same volume treatment, by request
    # Every stack that is not stale is kept WHOLE: its stopped containers are either a live
    # stack's one-shot jobs or a stack someone paused with `compose stop` (review, #847).
    kept_projects = set(stacks) - stale_projects

    # stopped containers
    for c in sorted(containers, key=lambda c: c.created):
        if c.id in removed or c.running or c.labels.get(PROJECT) in kept_projects:
            continue
        ended = c.finished or c.created
        if now - ended <= timedelta(hours=opts.stopped_hours):
            continue
        plan.append(Action("container", c.name, c.labels.get(PROJECT) or "(no stack)",
                           fmt_age(now - ended), None, [c.id]))
        removed.add(c.id)

    survivors = [c for c in containers if c.id not in removed]

    # images
    used = {c.image_id for c in survivors}
    for im in sorted(images, key=lambda i: i.created):
        if im.id in used or now - im.created <= timedelta(days=opts.image_days):
            continue
        name = im.tags[0] if im.tags else "<none>"
        # By every tag, not by ID: `docker rmi <id>` refuses an image with several tags
        # ("referenced in multiple repositories"); removing its last tag deletes it.
        plan.append(Action("image", name, im.id.replace("sha256:", "")[:12],
                           fmt_age(now - im.created), im.size, [im.id],
                           ["docker", "rmi", *(im.tags or (im.id,))]))

    # volumes
    attached = {m for c in survivors for m in c.mounts}
    for v in sorted(volumes, key=lambda v: v.name):
        if v.name in attached:
            continue
        proj = v.labels.get(PROJECT)
        anonymous = ANON_VOLUME.match(v.name) and not proj
        if anonymous or (proj and proj in orphaned_projects):
            plan.append(Action("volume", v.name[:40], proj or "anonymous", "", v.size, [v.name]))

    # build cache: keep the most recently used N GB. `--filter until=` is a silent no-op on
    # buildx 0.37 / BuildKit 0.33 (the weekly timer logged "Total: 0B" over 20 GB of cache).
    excess = build_cache_bytes - opts.cache_keep_gb * 10**9
    if excess > 0:
        plan.append(Action("buildcache", f"keep newest {opts.cache_keep_gb} GB",
                           f"of {fmt_size(build_cache_bytes)}, least recently used first", "",
                           excess, [],
                           ["docker", "buildx", "prune", "-f", "--max-used-space",
                            f"{opts.cache_keep_gb}GB"]))

    # tool caches (opt-in)
    if opts.caches:
        for tc in tool_caches:
            if tc.size > 0:
                if tc.exact:
                    plan.append(Action("cache", tc.name, tc.path, "", tc.size, [], tc.command))
                else:
                    plan.append(Action("cache", tc.name, f"{tc.path}: part of {fmt_size(tc.size)}",
                                       "", None, [], tc.command))
    return plan


# ----------------------------------------------------------------------------- docker I/O

def sh(args, check=True):
    r = subprocess.run(args, capture_output=True, text=True)
    if check and r.returncode != 0:
        raise RuntimeError(f"{' '.join(args)}: {r.stderr.strip() or r.stdout.strip()}")
    return r


def load_containers():
    ids = sh(["docker", "ps", "-aq", "--no-trunc"]).stdout.split()
    if not ids:
        return []
    out = []
    for d in json.loads(sh(["docker", "inspect", *ids]).stdout):
        st = d.get("State", {})
        out.append(Container(
            id=d["Id"], name=d["Name"].lstrip("/"), image_id=d.get("Image", ""),
            labels=(d.get("Config") or {}).get("Labels") or {}, running=bool(st.get("Running")),
            created=parse_time(d["Created"]), started=parse_time(st.get("StartedAt")),
            finished=parse_time(st.get("FinishedAt")),
            mounts=tuple(m["Name"] for m in d.get("Mounts") or [] if m.get("Type") == "volume"),
            restart_count=int(d.get("RestartCount") or 0),
        ))
    return out


def load_images():
    ids = sorted(set(sh(["docker", "image", "ls", "-aq", "--no-trunc"]).stdout.split()))
    if not ids:
        return []
    sizes = {}
    df = sh(["docker", "system", "df", "-v", "--format", "json"], check=False)
    if df.returncode == 0:
        for im in json.loads(df.stdout).get("Images") or []:
            sizes[im.get("ID", "")] = parse_size(im.get("UniqueSize") or im.get("Size"))
    out = []
    for d in json.loads(sh(["docker", "image", "inspect", *ids]).stdout):
        iid = d["Id"]
        short = iid.replace("sha256:", "")
        size = next((v for k, v in sizes.items() if k and short.startswith(k.replace("sha256:", ""))),
                    d.get("Size", 0))
        out.append(Image(id=iid, tags=tuple(d.get("RepoTags") or []),
                         created=parse_time(d["Created"]), size=size))
    return out


def load_volumes():
    names = sh(["docker", "volume", "ls", "-q"]).stdout.split()
    if not names:
        return []
    sizes = {}
    df = sh(["docker", "system", "df", "-v", "--format", "json"], check=False)
    if df.returncode == 0:
        for v in json.loads(df.stdout).get("Volumes") or []:
            sizes[v.get("Name")] = parse_size(v.get("Size"))
    return [Volume(name=d["Name"], labels=d.get("Labels") or {}, size=sizes.get(d["Name"], 0))
            for d in json.loads(sh(["docker", "volume", "inspect", *names]).stdout)]


def build_cache_bytes():
    """Reclaimable build cache (not in use), from `docker system df`."""
    r = sh(["docker", "system", "df", "--format", "{{json .}}"], check=False)
    for line in r.stdout.splitlines():
        try:
            rec = json.loads(line)
        except ValueError:
            continue
        if rec.get("Type") == "Build Cache":
            return parse_size(rec.get("Reclaimable"))
    return 0


def du(path):
    r = sh(["du", "-sb", path], check=False)
    try:
        return int(r.stdout.split()[0])
    except (IndexError, ValueError):
        return 0


def load_tool_caches():
    home = os.path.expanduser("~")
    items = []
    npm = os.path.join(home, ".npm", "_cacache")
    if os.path.isdir(npm) and shutil.which("npm"):
        items.append(CacheItem("npm cache", npm, du(npm), ["npm", "cache", "clean", "--force"]))
    uv = os.path.join(home, ".cache", "uv")
    if os.path.isdir(uv) and shutil.which("uv"):
        items.append(CacheItem("uv cache (prune unused)", uv, du(uv), ["uv", "cache", "prune"],
                               exact=False))
    pw = os.path.join(home, ".cache", "ms-playwright")
    if os.path.isdir(pw):
        newest = {}
        for d in os.listdir(pw):
            m = re.match(r"^(.*)-(\d+)$", d)
            if m and (m.group(1) not in newest or int(m.group(2)) > newest[m.group(1)][0]):
                newest[m.group(1)] = (int(m.group(2)), d)
        keep = {d for _, d in newest.values()}
        old = [os.path.join(pw, d) for d in os.listdir(pw)
               if re.match(r"^.*-\d+$", d) and d not in keep]
        if old:
            items.append(CacheItem(f"Playwright browsers ({len(old)} old builds)", pw,
                                   sum(du(p) for p in old), ["rm", "-rf", *old]))
    return items


def boot_times():
    """Every boot the journal remembers, plus the current one from /proc/uptime."""
    out = []
    try:
        with open("/proc/uptime") as f:
            out.append(datetime.now(timezone.utc) - timedelta(seconds=float(f.read().split()[0])))
    except OSError:
        pass
    r = sh(["journalctl", "--list-boots", "-o", "json", "--no-pager"], check=False)
    if r.returncode == 0:
        try:
            for b in json.loads(r.stdout or "[]"):
                # last_entry of a PAST boot marks its shutdown (the stops it caused); the current
                # boot's last_entry is just "now" and must not hide a real recent exit.
                keys = ("first_entry",) if b.get("index", 0) == 0 else ("first_entry", "last_entry")
                for k in keys:
                    if b.get(k):
                        out.append(datetime.fromtimestamp(b[k] / 1e6, timezone.utc))
        except ValueError:
            pass
    return out


def disk_line(path):
    try:
        u = shutil.disk_usage(path)
        return f"{path} {u.used / 1e9:.0f}/{u.total / 1e9:.0f} GB ({u.used * 100 // u.total}%)"
    except OSError:
        return f"{path} ?"


def docker_root():
    r = sh(["docker", "info", "-f", "{{.DockerRootDir}}"], check=False)
    return r.stdout.strip() or "/var/lib/docker"


# ----------------------------------------------------------------------------- worktree deps
#
# --deps: dependency dirs (node_modules, .venv, Rust target) inside git worktrees nobody has touched
# for --deps-days. They were the bulk of a full /workspace: on 2026-10-01 dev-worker-3 and
# dev-worker-2 each carried ~42 GB of them in worktrees idle for weeks, and dev-worker-3's agent
# could not start a single command. `npm ci` / `uv sync` / `cargo build` recreate all of it.
# Nothing else in a worktree is touched: no source, no git state, no untracked files.

DEPS_ROOTS = ("/workspace", "/home")
DISCOVERY_DEPTH = 6
# Never walked: tool caches and per-user container storage hold unpacked image filesystems and
# package tarballs, which contain `.git` and `node_modules` trees that are nobody's worktree.
SKIP_NAMES = frozenset({".git", ".cache", ".local", ".npm", ".npm-global", ".cache-npm",
                        ".cache-npm-global", ".cargo", ".rustup", ".pnpm-store", ".codex",
                        "lost+found"})


@dataclass(frozen=True)
class Worktree:
    path: str
    deps: tuple                         # absolute dep-dir paths
    last_activity: datetime | None      # None: something newer than the cutoff (fresh), or empty


def dep_kind(parent, name):
    """The dependency dirs --deps removes, each only where its own tool would recreate it."""
    if name == "node_modules":
        return True
    if name == ".venv":
        return os.path.isfile(os.path.join(parent, name, "pyvenv.cfg"))
    if name == "target":
        return os.path.isfile(os.path.join(parent, "Cargo.toml"))
    return False


def has_git(path):
    return os.path.lexists(os.path.join(path, ".git"))


def read_line(path):
    """The first line of a REGULAR file, at most 4 KiB; None for anything else. Runs as root over
    user-writable trees: a FIFO named .git would hang a plain open(), a symlink would be followed."""
    try:
        if not stat.S_ISREG(os.lstat(path).st_mode):
            return None
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
    except OSError:
        return None
    try:
        data = os.read(fd, 4096)
    except OSError:
        return None
    finally:
        os.close(fd)
    return data.decode(errors="replace").split("\n", 1)[0].strip()


def git_dir(worktree):
    """The worktree's git dir: `.git` itself, or the `gitdir:` a linked worktree's .git file names."""
    dotgit = os.path.join(worktree, ".git")
    if os.path.isdir(dotgit) and not os.path.islink(dotgit):
        return dotgit
    line = read_line(dotgit)
    if not line or not line.startswith("gitdir:"):
        return None
    return os.path.normpath(os.path.join(worktree, line[len("gitdir:"):].strip()))


def mtime(path):
    try:
        return os.lstat(path).st_mtime
    except OSError:
        return None


def under(path, parent):
    return path == parent or path.startswith(parent.rstrip("/") + "/")


def container_roots():
    """Container storage that may sit under a deps root (the dev-workers put docker's data-root and
    containerd's root on /workspace). Image layers there hold .git and node_modules trees."""
    out = {"/var/lib/docker", "/var/lib/containerd"}
    if shutil.which("docker"):
        r = sh(["docker", "info", "-f", "{{.DockerRootDir}}"], check=False)
        if r.returncode == 0 and r.stdout.strip():
            out.add(r.stdout.strip())
    try:
        with open("/etc/containerd/config.toml") as f:
            for line in f:
                m = re.match(r'^\s*root\s*=\s*"([^"]+)"', line)
                if m:
                    out.add(m.group(1))
    except OSError:
        pass
    return {os.path.realpath(p) for p in out}


def find_worktrees(roots, excluded=frozenset(), max_depth=DISCOVERY_DEPTH, min_uid=1000):
    """Git worktree roots (a dir holding a `.git` dir or file) under each root, nested ones included.
    Only a root's top-level dirs owned by a regular user (uid >= 1000) are walked — the per-user
    workspaces and homes, never root-owned service state. Stays on the root's filesystem, follows
    no symlink, never enters a dependency dir or anything in SKIP_NAMES or `excluded`."""
    found = []
    for root in roots:
        root = os.path.realpath(root)
        try:
            dev = os.stat(root).st_dev
            top = list(os.scandir(root))
        except OSError:
            continue
        stack = []
        for e in top:
            try:
                st = e.stat(follow_symlinks=False)
            except OSError:
                continue
            if (e.is_dir(follow_symlinks=False) and e.name not in SKIP_NAMES
                    and st.st_uid >= min_uid and st.st_dev == dev):
                stack.append((e.path, 1))
        while stack:
            path, depth = stack.pop()
            if any(under(path, x) for x in excluded):
                continue
            if has_git(path):
                found.append(path)
            if depth >= max_depth:
                continue
            try:
                entries = list(os.scandir(path))
            except OSError:
                continue
            for e in entries:
                if e.name in SKIP_NAMES or not e.is_dir(follow_symlinks=False):
                    continue
                if dep_kind(path, e.name):
                    continue
                try:
                    if e.stat(follow_symlinks=False).st_dev != dev:
                        continue
                except OSError:
                    continue
                stack.append((e.path, depth + 1))
    return sorted(found)


def scan_worktree(path, cutoff):
    """Dependency dirs and last activity of one worktree. Activity = the newest mtime of any file or
    directory outside the dependency dirs and nested worktrees, of each dependency dir itself (an
    `npm ci` replaces it), and of the git index, HEAD and HEAD reflog (checkout, commit, the index
    refresh `git status` does). Returns last_activity=None — treat as in use — at the first mtime
    newer than `cutoff`, and on ANY error reading the tree: a scan that could not see everything
    proves nothing about idleness (an entry vanishing mid-scan is itself activity)."""
    fresh = Worktree(path, (), None)
    newest = 0.0
    gd = git_dir(path)
    if gd:
        for p in (os.path.join(gd, "index"), os.path.join(gd, "HEAD"),
                  os.path.join(gd, "logs", "HEAD")):
            newest = max(newest, mtime(p) or 0.0)      # absent (no reflog yet) is normal
    if newest > cutoff:
        return fresh
    deps = []
    stack = [path]
    try:
        while stack:
            d = stack.pop()
            newest = max(newest, os.lstat(d).st_mtime)
            if newest > cutoff:
                return fresh
            for e in list(os.scandir(d)):
                if d == path and e.name == ".git":
                    continue
                if e.is_dir(follow_symlinks=False):
                    if dep_kind(d, e.name):
                        deps.append(e.path)
                    elif has_git(e.path):
                        continue                    # a nested worktree is judged on its own
                    else:
                        stack.append(e.path)
                        continue
                newest = max(newest, e.stat(follow_symlinks=False).st_mtime)
                if newest > cutoff:
                    return fresh
    except OSError:
        return fresh
    if not newest:
        return fresh
    return Worktree(path, tuple(sorted(deps)), datetime.fromtimestamp(newest, timezone.utc))


def inspect_dep(path):
    """(identity, bytes, problem) for one dependency dir. Walks it the way the removal will, so a
    dir the removal must not touch is refused here: one holding a `.git` (a real checkout inside
    node_modules is somebody's work), or a mount (a bind inside would make the delete recurse into
    another filesystem). problem=None means safe to plan."""
    try:
        top = os.lstat(path)
    except OSError:
        return None, 0, "unreadable"
    ident = (top.st_dev, top.st_ino)
    total = 0
    stack = [path]
    try:
        while stack:
            d = stack.pop()
            with os.scandir(d) as it:
                entries = list(it)
            for e in entries:
                if e.name == ".git":
                    return ident, total, "contains a git checkout"
                st = e.stat(follow_symlinks=False)
                if st.st_dev != top.st_dev:
                    return ident, total, "has a mount inside"
                total += st.st_blocks * 512
                if stat.S_ISDIR(st.st_mode):
                    stack.append(e.path)
    except OSError:
        return ident, total, "unreadable"
    return ident, total, None


def mount_points():
    """Every mount point, from /proc/self/mountinfo (octal escapes like \\040 decoded)."""
    out = set()
    try:
        with open("/proc/self/mountinfo") as f:
            for line in f:
                parts = line.split()
                if len(parts) > 4:
                    out.add(re.sub(r"\\([0-7]{3})", lambda m: chr(int(m.group(1), 8)), parts[4]))
    except OSError:
        pass
    return out


def busy_paths():
    """Every path a process is using — cwd, root, executable, open files and mapped files (a
    python running from a .venv maps its .so files without holding them open) — from /proc.
    Only root sees other users' processes, which is why --deps removes nothing unless run as root."""
    out = set()
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        base = os.path.join("/proc", pid)
        links = [os.path.join(base, n) for n in ("cwd", "root", "exe")]
        try:
            links += [os.path.join(base, "fd", fd) for fd in os.listdir(os.path.join(base, "fd"))]
        except OSError:
            pass
        for link in links:
            try:
                target = os.readlink(link)
            except OSError:
                continue
            if target.startswith("/"):
                out.add(target.removesuffix(" (deleted)"))
        try:
            with open(os.path.join(base, "maps")) as f:
                for line in f:
                    parts = line.split(None, 5)
                    if len(parts) == 6 and parts[5].startswith("/"):
                        out.add(parts[5].rstrip(chr(10)).removesuffix(" (deleted)"))
        except OSError:
            pass
    out.discard("/")
    return out


def bind_mount_sources():
    """Host paths bind-mounted into RUNNING containers (a compose dev stack mounting a worktree)."""
    if not shutil.which("docker"):
        return set()
    ps = sh(["docker", "ps", "-q", "--no-trunc"], check=False)
    if ps.returncode != 0:
        # Not "no containers": with live-restore they keep running while dockerd is down.
        raise RuntimeError("docker ps failed; refusing to guess which worktrees containers mount")
    ids = ps.stdout.split()
    if not ids:
        return set()
    r = sh(["docker", "inspect", *ids], check=False)
    if r.returncode != 0:
        raise RuntimeError("docker inspect of the running containers failed; refusing to guess "
                           "which worktrees they mount")
    return {m["Source"] for d in json.loads(r.stdout) for m in d.get("Mounts") or []
            if m.get("Type") == "bind" and m.get("Source")}


def in_use(worktree, busy, binds):
    """A process works inside the worktree, or a running container mounts it, part or whole."""
    return (any(under(p, worktree) for p in busy)
            or any(under(b, worktree) or under(worktree, b) for b in binds if b != "/"))


def load_worktrees(roots, days, now, excluded=frozenset(), min_uid=1000):
    cutoff = (now - timedelta(days=days)).timestamp()
    return [scan_worktree(p, cutoff) for p in find_worktrees(roots, excluded, min_uid=min_uid)]


def plan_deps(worktrees, days, now, busy, binds, mounts=frozenset(), inspect=None):
    """One action per idle worktree with dependency dirs. Its fingerprint pins each dir's
    (path, dev, inode): a dir replaced after the scan (a fresh `npm ci`) is not the planned one.
    Returns (plan, refused) — refused lists the dirs inspect_dep would not plan, with why."""
    inspect = inspect or inspect_dep
    plan, refused = [], []
    for w in worktrees:
        if not w.deps or w.last_activity is None:
            continue
        if now - w.last_activity <= timedelta(days=days) or in_use(w.path, busy, binds):
            continue
        keep, size, idents = [], 0, set()
        for d in w.deps:
            ident, n, problem = inspect(d)
            if problem is None and any(under(m, d) for m in mounts):
                problem = "has a mount inside"
            if problem:
                refused.append((d, problem))
                continue
            keep.append(d)
            size += n
            idents.add((d, *ident))
        if keep:
            plan.append(Action("deps", w.path, ", ".join(os.path.relpath(d, w.path) for d in keep),
                               fmt_age(now - w.last_activity), size, keep,
                               fingerprint=frozenset(idents)))
    return plan, refused


def open_dir_nofollow(path):
    """An fd for `path`, opened one component at a time with O_NOFOLLOW: a symlink swapped into any
    component (between the scan and the removal) fails the open instead of being followed. This
    runs as root over user-writable trees."""
    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC
    fd = os.open("/", flags)
    try:
        for comp in [c for c in path.split("/") if c]:
            nxt = os.open(comp, flags, dir_fd=fd)
            os.close(fd)
            fd = nxt
    except OSError:
        os.close(fd)
        raise
    return fd


def remove_dep_dir(path, ident):
    """Move the dir aside under a dot-name in its own parent, then delete it. The rename is atomic:
    a tool starting now finds no dir and builds a fresh one instead of racing the delete. Both steps
    are relative to the parent's fd, so neither can be redirected outside the planned tree; the dir
    must still be the planned inode. False = not removed (it changed)."""
    parent, name = os.path.split(path)
    pfd = open_dir_nofollow(parent)
    try:
        st = os.stat(name, dir_fd=pfd, follow_symlinks=False)
        if not stat.S_ISDIR(st.st_mode) or (st.st_dev, st.st_ino) != ident:
            return False
        trash = f".{name}.cleanup-{os.getpid()}"
        os.rename(name, trash, src_dir_fd=pfd, dst_dir_fd=pfd)
        shutil.rmtree(trash, dir_fd=pfd)
        return True
    finally:
        os.close(pfd)


def remove_deps(action, days, now, busy, binds, mounts):
    """Re-judge the worktree right before deleting — it may have been picked up since the scan —
    with the CALLER's fresh `busy`/`binds`/`mounts`, then remove exactly the planned dep dirs that
    the fresh scan still finds, as the same inodes, and that inspect_dep still clears. The re-inspect
    matters: scan_worktree does not look inside dep dirs, and a checkout cloned into
    node_modules/a after the plan leaves node_modules' own inode and mtime unchanged (review, #1005).
    Returns how many were removed; None = the whole worktree was skipped."""
    w = scan_worktree(action.label, (now - timedelta(days=days)).timestamp())
    if w.last_activity is None or in_use(action.label, busy, binds):
        return None
    idents = {p: (dev, ino) for p, dev, ino in action.fingerprint or ()}
    removed = 0
    for d in action.ids:
        if not (d in w.deps and d in idents and under(d, action.label)):
            continue
        if any(under(m, d) for m in mounts) or inspect_dep(d)[2] is not None:
            continue
        if remove_dep_dir(d, idents[d]):
            removed += 1
    return removed


# ----------------------------------------------------------------------------- stale worktrees
#
# --worktrees: whole LINKED git worktrees (`.git` is a file) that hold nothing git does not already
# have. Agents create one per task and never remove it: on 2026-10-02 dev-worker-3 carried 190.
# Removal is `git worktree remove` WITHOUT --force, run as the worktree's owner, so git itself
# refuses a dirty, untracked, locked or submodule worktree a second time; the branch ref is never
# touched. What goes is the working copy, its DISPOSABLE ignored files (dependency and build output)
# and the worktree's HEAD reflog. Main clones and submodules are never candidates. Root only reads
# here (lstat, one-line metadata files); every write is git running as the owner.

IN_PROGRESS = ("MERGE_HEAD", "CHERRY_PICK_HEAD", "REVERT_HEAD", "BISECT_LOG", "rebase-merge",
               "rebase-apply", "sequencer", "index.lock")
# A built environment, nothing inherited (no GIT_DIR, GIT_INDEX_FILE…). Status must not refresh the
# index: that write would be "activity" to the next scan. Replacement objects would let the
# repository rewrite what the merge proof sees.
GIT_ENV = {"PATH": "/usr/local/bin:/usr/bin:/bin", "LC_ALL": "C", "GIT_TERMINAL_PROMPT": "0",
           "GIT_OPTIONAL_LOCKS": "0", "GIT_NO_REPLACE_OBJECTS": "1"}
# fsmonitor and hooks are the owner's code.
GIT_OPTS = ["-c", "core.fsmonitor=false", "-c", "core.hooksPath=/dev/null"]
MIN_UID = 1000                          # regular accounts only; never a service account's tree
NOBODY = 65534
# Ignored content a worktree may lose: what a tool regenerates (the list grew from what the
# workers' worktrees actually hold, 2026-10-02). Anything else ignored (.env, a local database,
# secrets/) keeps the worktree.
DISPOSABLE = frozenset({"node_modules", "__pycache__", ".pytest_cache", ".mypy_cache", ".ruff_cache",
                        ".tox", ".nox", ".hypothesis", ".coverage", "dist", "dist-portable", "build",
                        "out", ".next", ".nuxt", ".svelte-kit", ".turbo", ".parcel-cache", ".vite",
                        "coverage", "htmlcov", "playwright-report", "test-results",
                        ".failure-context", ".terraform", ".eslintcache", "auto-imports.d.ts",
                        "components.d.ts"})
DISPOSABLE_PREFIXES = (".coverage.", "test-results-")
DISPOSABLE_DIR_SUFFIXES = (".egg-info",)
DISPOSABLE_FILE_SUFFIXES = (".pyc", ".tsbuildinfo", ".log")     # a FILE only: never `archive.log/`
# A remote proves "it is on the forge" only when it is one: a local path or file:// remote is
# another directory on this disk.
NETWORK_URL = re.compile(r"^((https?|ssh|git)://|[^/\s@]+@[^/\s:]+:)")


@dataclass(frozen=True)
class Link:
    gitdir: str                         # <common>/worktrees/<id>
    common: str                         # the main clone's .git


def linked_worktree(path):
    """(Link, None) for a linked worktree whose admin dir points back at it, else (None, why).
    (None, None): not a linked worktree at all (a submodule's .git file points into .git/modules)."""
    dotgit = os.path.join(path, ".git")
    gd = git_dir(path)
    if not gd or gd == dotgit:
        return None, None if gd else "unreadable .git"
    if os.path.basename(os.path.dirname(gd)) != "worktrees":
        return None, None
    back = read_line(os.path.join(gd, "gitdir"))
    if not back or os.path.normpath(os.path.join(gd, back)) != dotgit:
        return None, "admin dir does not point back (run `git worktree repair`)"
    rel = read_line(os.path.join(gd, "commondir"))
    common = os.path.dirname(os.path.dirname(gd))
    if not rel or os.path.normpath(os.path.join(gd, rel)) != common:
        return None, "unexpected commondir"
    return Link(gd, common), None


def account(uid):
    """The owner's passwd entry when it is a regular account, else None."""
    import pwd  # Linux only; imported here so the tests import this file anywhere
    if uid < MIN_UID or uid == NOBODY:
        return None
    try:
        return pwd.getpwuid(uid)
    except KeyError:
        return None


def run_git(uid, args, cwd):
    """git as the worktree's owner, never as root: root running git in a user's repo would run that
    user's fsmonitor, hooks and config with root's rights. Root drops to the owner with runuser; a
    non-root dry run can only ask about its own worktrees."""
    import pwd  # Linux only; imported here so the tests import this file anywhere
    try:
        pw = pwd.getpwuid(uid)
    except KeyError:
        raise RuntimeError(f"uid {uid} has no account")
    env = dict(GIT_ENV, HOME=pw.pw_dir, USER=pw.pw_name)
    cmd = ["git", *GIT_OPTS, *args]
    if os.geteuid() == 0 and uid != 0:
        # Absolute: the PATH above is the one git gets, and runuser lives in /usr/sbin.
        runuser = shutil.which("runuser", path="/usr/sbin:/usr/bin:/sbin:/bin")
        if not runuser:
            raise RuntimeError("runuser not found")
        cmd = [runuser, "-u", pw.pw_name, "--", *cmd]
    elif os.geteuid() != uid:
        raise RuntimeError("owned by another user (run with sudo)")
    return subprocess.run(cmd, cwd=cwd, env=env, stdin=subprocess.DEVNULL, capture_output=True,
                          text=True, timeout=300)


GIT = run_git                           # tests run git as themselves


def git_out(uid, args, cwd):
    """stdout of a git call; None when it failed (callers treat that as "not proven")."""
    r = GIT(uid, args, cwd)
    return r.stdout.strip() if r.returncode == 0 else None


def container_claims():
    """Paths ANY container — running or stopped — bind-mounts or was composed from (its compose
    working_dir label). A stopped stack whose directory vanished would later look orphaned to
    `cleanup`, which then removes its named volumes."""
    if not shutil.which("docker"):
        return set()
    ps = sh(["docker", "ps", "-aq", "--no-trunc"], check=False)
    if ps.returncode != 0:
        raise RuntimeError("docker ps -a failed; refusing to guess which worktrees containers use")
    ids = ps.stdout.split()
    if not ids:
        return set()
    r = sh(["docker", "inspect", *ids], check=False)
    errors = [line for line in (r.stderr or "").splitlines() if line.strip()]
    if r.returncode != 0 and not (errors and all("No such object" in e for e in errors)):
        raise RuntimeError("docker inspect failed; refusing to guess which worktrees containers use")
    try:
        found = json.loads(r.stdout)    # a container gone since `ps` is simply not in the output
    except ValueError:
        raise RuntimeError("docker inspect printed no JSON; refusing to guess which worktrees "
                           "containers use")
    out = set()
    for d in found:
        out |= {m["Source"] for m in d.get("Mounts") or []
                if m.get("Type") == "bind" and m.get("Source")}
        wd = ((d.get("Config") or {}).get("Labels") or {}).get(WORKDIR)
        if wd:
            out.add(wd)
    return out


def inspect_worktree(path, cutoff):
    """(bytes, problem) for the whole tree — dependency dirs included, no depth limit, lstat only —
    walked the way the removal will delete it. Refused: another checkout inside (a gitignored clone
    would go with it), a mount, an entry owned by someone else (the owner's removal would fail half
    way), or anything modified after `cutoff` (a write deep in node_modules leaves the dir's own
    mtime alone, so scan_worktree cannot see it)."""
    try:
        top = os.lstat(path)
    except OSError:
        return 0, "unreadable"
    total = 0
    stack = [path]
    try:
        while stack:
            d = stack.pop()
            with os.scandir(d) as it:
                entries = list(it)
            for e in entries:
                rel = os.path.relpath(e.path, path)
                if e.name == ".git" and d != path:
                    return total, f"contains another checkout ({os.path.dirname(rel)})"
                if e.name == "HEAD" and d != path and os.path.isdir(os.path.join(d, "objects")) \
                        and os.path.isdir(os.path.join(d, "refs")):
                    # A bare repository (a mirror under an ignored build/): its own history.
                    return total, f"contains a git repository ({os.path.dirname(rel)})"
                st = e.stat(follow_symlinks=False)
                if st.st_dev != top.st_dev:
                    return total, "has a mount inside"
                if st.st_uid != top.st_uid:
                    return total, f"{rel} is owned by uid {st.st_uid}"
                if st.st_mtime > cutoff:
                    return total, f"{rel} modified recently"
                total += st.st_blocks * 512
                if stat.S_ISDIR(st.st_mode):
                    stack.append(e.path)
    except OSError:
        return total, "unreadable"
    return total, None


def disposable(path, entry):
    """An ignored path git listed (relative; a dir ends with "/") that a tool would regenerate."""
    parts = entry.rstrip("/").split("/")
    if not entry.endswith("/") and parts[-1].endswith(DISPOSABLE_FILE_SUFFIXES):
        return True
    for i, name in enumerate(parts):
        parent = os.path.join(path, *parts[:i])
        if name in DISPOSABLE or name.startswith(DISPOSABLE_PREFIXES) or \
                name.endswith(DISPOSABLE_DIR_SUFFIXES):
            return True
        if name in (".venv", "venv") and os.path.isfile(os.path.join(parent, name, "pyvenv.cfg")):
            return True
        if name == "target" and os.path.isfile(os.path.join(parent, "Cargo.toml")):
            return True
    return False


def network_remotes(uid, path):
    out = git_out(uid, ["config", "--get-regexp", r"^remote\..*\.url$"], path) or ""
    names = set()
    for line in out.splitlines():
        key, _, url = line.partition(" ")
        if NETWORK_URL.match(url.strip()):
            names.add(key[len("remote."):-len(".url")])
    return sorted(names)


def default_branches(uid, path, remotes):
    """Each network remote's default branch: `refs/remotes/<r>/HEAD`'s target, else <r>/main, else
    <r>/master — fully qualified."""
    out = git_out(uid, ["for-each-ref", "--format=%(refname) %(symref)", "refs/remotes"], path)
    if out is None:
        return []
    refs = dict((line.split(" ") + [""])[:2] for line in out.splitlines() if line)
    heads = []
    for r in remotes:
        base = f"refs/remotes/{r}/"
        target = refs.get(base + "HEAD")
        if target and target.startswith(base) and target in refs:
            heads.append(target)
        elif base + "main" in refs:
            heads.append(base + "main")
        elif base + "master" in refs:
            heads.append(base + "master")
    return heads


def merged_into(uid, path, ref, head):
    """True when merging HEAD into `ref` would not change `ref`'s tree: everything the worktree's
    branch did is already there. Catches squash merges (how Gitea merges here), which an ancestry
    check misses. Exit 0 is clean, 1 a conflict, anything else an error: only 0 counts."""
    r = GIT(uid, ["merge-tree", "--write-tree", ref, head], path)
    if r.returncode != 0:
        return False
    tree = r.stdout.split("\n", 1)[0].strip()
    return bool(tree) and tree == git_out(uid, ["rev-parse", "--verify", "-q", f"{ref}^{{tree}}"],
                                          path)


def judge_worktree(w, days, merged_days, now, busy, claims, mounts):
    """(rule, problem, head): rule is "merged" or "stale" when the worktree may go; otherwise problem
    says why not, or is None when it simply is not idle long enough / is not a linked worktree."""
    no = (None, None, None)
    if w.last_activity is None:
        return no
    idle = now - w.last_activity
    if idle <= timedelta(days=merged_days):
        return no
    if os.path.isdir(os.path.join(w.path, ".git")):
        return no                                   # a main clone: never a candidate
    link, why = linked_worktree(w.path)
    if not link:
        return None, why, None
    if in_use(w.path, busy, claims) or any(under(m, w.path) for m in mounts):
        return None, "in use", None
    uid = os.lstat(w.path).st_uid
    if account(uid) is None or os.lstat(link.common).st_uid != uid:
        return None, "not owned by one regular account", None
    if not read_line(os.path.join(link.gitdir, "HEAD")):
        return None, "unreadable HEAD", None
    for name in IN_PROGRESS:
        if os.path.lexists(os.path.join(link.gitdir, name)):
            return None, f"{name} in progress", None
    if os.path.lexists(os.path.join(link.gitdir, "locked")):
        return None, "locked", None
    if any(files for _, _, files in os.walk(os.path.join(link.gitdir, "refs"))):
        return None, "has worktree-private refs", None
    if os.path.lexists(os.path.join(link.common, "shallow")):
        return None, "shallow repository", None
    listed = git_out(uid, ["worktree", "list", "--porcelain"], w.path) or ""
    if f"worktree {w.path}" not in listed.splitlines():
        return None, "git does not list it as a worktree", None
    head = git_out(uid, ["rev-parse", "--verify", "-q", "HEAD"], w.path)
    if not head:
        return None, "no commit checked out", None
    status = git_out(uid, ["status", "--porcelain=v1", "--untracked-files=all"], w.path)
    if status is None:
        return None, "git status failed", None
    if status:
        return None, f"uncommitted changes ({len(status.splitlines())} paths)", None
    flags = git_out(uid, ["ls-files", "-v"], w.path)
    if flags is None:
        return None, "git ls-files failed", None
    if any(line[:1].islower() or line[:1] == "S" for line in flags.splitlines()):
        return None, "assume-unchanged or skip-worktree entries", None
    ignored = git_out(uid, ["ls-files", "--others", "--ignored", "--exclude-standard",
                            "--directory"], w.path)
    if ignored is None:
        return None, "git ls-files failed", None
    for entry in ignored.splitlines():
        if not disposable(w.path, entry):
            return None, f"ignored {entry} may matter", None
    remotes = network_remotes(uid, w.path)
    r = GIT(uid, ["config", "--get-regexp", r"^merge\..*\.driver$"], w.path)
    if r.returncode not in (0, 1):                  # 1 = no such key
        return None, "git config failed", None
    drivers = r.returncode == 0 and r.stdout.strip()
    if not drivers and any(merged_into(uid, w.path, ref, head)
                           for ref in default_branches(uid, w.path, remotes)):
        return "merged", None, head
    if idle <= timedelta(days=days):
        return no
    if not any(git_out(uid, ["for-each-ref", "--contains", head, "--count=1",
                             "--format=%(refname)", f"refs/remotes/{r}/"], w.path)
               for r in remotes):
        return None, "HEAD is not on any remote branch", None
    return "stale", None, head


def rule_cutoff(rule, days, merged_days, now):
    """The idle threshold a rule demands, as a timestamp: nothing in the tree may be newer."""
    return (now - timedelta(days=merged_days if rule == "merged" else days)).timestamp()


def plan_worktrees(worktrees, days, merged_days, now, busy, claims, mounts):
    """One action per removable worktree; `kept` lists those idle past `days` that are not, with
    why — the owner's to-do list. Younger worktrees that are merely unmerged are neither: they are
    still somebody's work."""
    plan, kept = [], []
    for w in worktrees:
        try:
            rule, problem, head = judge_worktree(w, days, merged_days, now, busy, claims, mounts)
            if rule:
                size, problem = inspect_worktree(w.path, rule_cutoff(rule, days, merged_days, now))
            if rule and not problem:
                st = os.lstat(w.path)
                branch = git_out(st.st_uid, ["symbolic-ref", "-q", "--short", "HEAD"], w.path)
                plan.append(Action("worktree", w.path, f"{rule}, {branch or 'detached'}",
                                   fmt_age(now - w.last_activity), size, [w.path],
                                   fingerprint=frozenset({(st.st_dev, st.st_ino, head)})))
                continue
        except (OSError, RuntimeError, subprocess.SubprocessError) as e:
            problem = str(e)
        if problem and w.last_activity and now - w.last_activity > timedelta(days=days):
            kept.append((w.path, problem))
    return plan, kept


def remove_worktree(action, days, merged_days, now, busy, claims, mounts):
    """Re-judge with the CALLER's fresh state right before removing — it may have been picked up,
    changed or replaced since the scan — then `git worktree remove` (no --force) as the owner.
    Returns None when it no longer qualifies, else git's error text ("" = removed)."""
    path = action.label
    try:
        st = os.lstat(path)
    except FileNotFoundError:
        return None
    w = scan_worktree(path, (now - timedelta(days=merged_days)).timestamp())
    rule, _, head = judge_worktree(w, days, merged_days, now, busy, claims, mounts)
    if not rule or action.fingerprint != frozenset({(st.st_dev, st.st_ino, head)}):
        return None
    if inspect_worktree(path, rule_cutoff(rule, days, merged_days, now))[1] is not None:
        return None
    link, _ = linked_worktree(path)
    if not link:                                    # its .git changed since the judgement
        return None
    r = GIT(st.st_uid, ["worktree", "remove", path], link.common)
    return "" if r.returncode == 0 else ((r.stderr or r.stdout).strip().splitlines() or ["failed"])[-1]


# ----------------------------------------------------------------------------- output

IMAGE_ROWS = 10


def display_rows(plan, show_all):
    """Table rows. The plan stays one entry per object (execution is exact); the table groups
    stopped containers per stack, anonymous volumes into one row, and shows the largest images
    plus an 'N more' row — unless show_all."""
    if show_all:
        return [[CATEGORY[a.kind], a.label, a.detail, a.age, fmt_size(a.size)] for a in plan]
    rows = []
    stopped = {}
    anon = []
    images = []
    deps = []
    for a in plan:
        if a.kind == "container":
            stopped.setdefault(a.detail, []).append(a)
        elif a.kind == "volume" and a.detail == "anonymous":
            anon.append(a)
        elif a.kind == "image":
            images.append(a)
        elif a.kind in ("deps", "worktree"):
            deps.append(a)
        else:
            rows.append([CATEGORY[a.kind], a.label, a.detail, a.age, fmt_size(a.size)])
    for stack, acts in stopped.items():
        rows.append([CATEGORY["container"], stack, f"{len(acts)} stopped containers",
                     min((a.age for a in acts), key=_age_key), "?"])
    if anon:
        rows.append([CATEGORY["volume"], f"{len(anon)} anonymous volumes", "no container uses them",
                     "", fmt_size(sum(a.size or 0 for a in anon))])
    images.sort(key=lambda a: a.size or 0, reverse=True)
    for a in images[:IMAGE_ROWS]:
        rows.append([CATEGORY["image"], a.label, a.detail, a.age, fmt_size(a.size)])
    rest = images[IMAGE_ROWS:]
    if rest:
        rows.append([CATEGORY["image"], f"… {len(rest)} more images", "cleanup --dry-run --all lists them",
                     "", fmt_size(sum(a.size or 0 for a in rest))])
    for kind in ("deps", "worktree"):
        acts = sorted((a for a in deps if a.kind == kind), key=lambda a: a.size or 0, reverse=True)
        for a in acts[:IMAGE_ROWS]:
            rows.append([CATEGORY[kind], a.label, a.detail, a.age, fmt_size(a.size)])
        rest = acts[IMAGE_ROWS:]
        if rest:
            rows.append([CATEGORY[kind], f"… {len(rest)} more worktrees",
                         "cleanup --dry-run --all lists them", "",
                         fmt_size(sum(a.size or 0 for a in rest))])
    order = list(CATEGORY.values())
    return sorted(rows, key=lambda r: order.index(r[0]))


def _age_key(age):
    m = re.match(r"^(?:(\d+)w)?(?:(\d+)d)?(?:(\d+)h)?$", age or "")
    if not m:
        return 0
    w, d, h = (int(x or 0) for x in m.groups())
    return (w * 7 + d) * 24 + h


def render(plan, width, show_all=False):
    headers = ["#", "Category", "Item", "Detail", "Age", "Size"]
    rows = [[str(i + 1), *r] for i, r in enumerate(display_rows(plan, show_all))]
    widths = [max(len(h), *(len(r[i]) for r in rows)) for i, h in enumerate(headers)]
    budget = max(width - (sum(widths) - widths[2] - widths[3]) - 3 * len(headers) - 1, 30)
    widths[2] = min(widths[2], max(budget // 2, 14))
    widths[3] = min(widths[3], max(budget - widths[2], 16))

    def cut(s, w):
        return s if len(s) <= w else s[: w - 1] + "…"

    def line(l, m, r):
        return l + m.join("─" * (w + 2) for w in widths) + r

    out = [line("┌", "┬", "┐"),
           "│" + "│".join(f" {h:<{w}} " for h, w in zip(headers, widths)) + "│",
           line("├", "┼", "┤")]
    for r in rows:
        cells = [cut(c, w) for c, w in zip(r, widths)]
        out.append("│" + "│".join(
            f" {c:>{w}} " if i in (0, 5) else f" {c:<{w}} " for i, (c, w) in enumerate(zip(cells, widths))
        ) + "│")
    out.append(line("└", "┴", "┘"))
    return "\n".join(out)


def summary(plan):
    known = sum(a.size or 0 for a in plan)
    n = {k: sum(1 for a in plan if a.kind == k) for k in CATEGORY}
    parts = []
    if n["stack"]:
        ctrs = sum(len(a.ids) for a in plan if a.kind == "stack")
        parts.append(f"{n['stack']} stale stack(s) ({ctrs} containers)")
    for k, word in (("container", "stopped container(s)"), ("image", "image(s)"),
                    ("volume", "volume(s)"), ("cache", "tool cache(s)"),
                    ("deps", "idle worktree(s)' dependency dirs"),
                    ("worktree", "stale worktree(s)")):
        if n[k]:
            parts.append(f"{n[k]} {word}")
    if n["buildcache"]:
        parts.append("old build cache")
    note = (" (stack containers free their images above; shared layers are not counted)"
            if n["stack"] or n["image"] else "")
    return f"Will remove: {', '.join(parts)}. Frees at least {fmt_size(known)}{note}."


# ----------------------------------------------------------------------------- execution

def live_stack_fingerprint(label):
    """The stack's containers right now, as {(id, started, finished)}."""
    ids = sh(["docker", "ps", "-aq", "--no-trunc", "--filter", f"label={PROJECT}={label}"],
             check=False).stdout.split()
    if not ids:
        return frozenset()
    r = sh(["docker", "inspect", *ids], check=False)
    if r.returncode != 0:
        return frozenset()
    return frozenset((d["Id"], parse_time(d["State"].get("StartedAt")),
                      parse_time(d["State"].get("FinishedAt"))) for d in json.loads(r.stdout))


def tag_image_id(tag):
    r = sh(["docker", "image", "inspect", "-f", "{{.Id}}", tag], check=False)
    return r.stdout.strip() if r.returncode == 0 else None


def still_planned(action, fresh_plan):
    """After the prompt, only act on what a fresh scan would still remove (review, #847): a
    container started in the meantime, or a stack that changed, drops out."""
    if not action.ids:
        return True
    fresh = {(a.kind, a.label): set(a.ids) for a in fresh_plan if a.kind == "stack"}
    if action.kind == "stack":
        return fresh.get(("stack", action.label)) == set(action.ids)
    ids = {i for a in fresh_plan if a.kind == action.kind for i in a.ids}
    return all(i in ids for i in action.ids)


def execute(plan, fresh_plan, deps_days=None, worktree_days=None, merged_days=None):
    failures = skipped = 0
    for i, a in enumerate(plan, 1):
        if not still_planned(a, fresh_plan):
            print(f"  – {i:>3} {CATEGORY[a.kind]}: {a.label} — changed since the scan, skipped")
            skipped += 1
            continue
        if a.kind == "worktree":
            try:
                err = remove_worktree(a, worktree_days, merged_days, datetime.now(timezone.utc),
                                      busy_paths(), container_claims(), mount_points())
            except (OSError, RuntimeError, subprocess.SubprocessError) as e:
                err = str(e)
            if err is None:
                print(f"  – {i:>3} {CATEGORY[a.kind]}: {a.label} — in use or changed since the scan, "
                      "skipped")
                skipped += 1
            elif err:
                print(f"  ✗ {i:>3} {CATEGORY[a.kind]}: {a.label} — {err}")
                failures += 1
            else:
                print(f"  ✓ {i:>3} {CATEGORY[a.kind]}: {a.label}")
            continue
        if a.kind == "deps":
            # Fresh /proc, container and mount state for EVERY worktree, right before its removal:
            # the plan's snapshot is minutes old by the time a long run reaches the last one.
            try:
                n = remove_deps(a, deps_days, datetime.now(timezone.utc), busy_paths(),
                                bind_mount_sources(), mount_points())
            except (OSError, RuntimeError) as e:
                print(f"  ✗ {i:>3} {CATEGORY[a.kind]}: {a.label} — {e}")
                failures += 1
                continue
            if n is None:
                print(f"  – {i:>3} {CATEGORY[a.kind]}: {a.label} — in use or touched since the scan, "
                      "skipped")
                skipped += 1
            else:
                note = "" if n == len(a.ids) else f" ({n} of {len(a.ids)}; the rest changed)"
                print(f"  ✓ {i:>3} {CATEGORY[a.kind]}: {a.label}{note}")
            continue
        cmds = []
        # No `-v`: anonymous volumes are planned as their own actions; `rm -v` deleted them
        # first and the volume step then failed (review, #847).
        if a.kind == "container":
            cmds = [["docker", "rm", *a.ids]]          # stopped: no force, a started one fails
        elif a.kind == "stack":
            # Right before the forced removal, not just at the rescan (review round 2, #847): any
            # container added, started or stopped since the plan was shown skips the stack.
            if live_stack_fingerprint(a.label) != a.fingerprint:
                print(f"  – {i:>3} {CATEGORY[a.kind]}: {a.label} — changed since the scan, skipped")
                skipped += 1
                continue
            cmds = [["docker", "rm", "-f", *a.ids]]
            nets = sh(["docker", "network", "ls", "-q", "--filter",
                       f"label={PROJECT}={a.label}"], check=False).stdout.split()
            if nets:
                cmds.append(["docker", "network", "rm", *nets])
        elif a.kind == "image":
            # Re-resolve every tag (review round 2, #847): a tag moved to a new image since the
            # scan is dropped; with no tag left, remove the planned image by ID.
            tags = [t for t in a.command[2:] if t != a.ids[0] and tag_image_id(t) == a.ids[0]]
            cmds = [["docker", "rmi", *tags]] if tags else [["docker", "rmi", a.ids[0]]]
        elif a.kind == "volume":
            cmds = [["docker", "volume", "rm", *a.ids]]
        elif a.command:
            cmds = [a.command]
        ok = True
        for cmd in cmds:
            r = sh(cmd, check=False)
            if r.returncode != 0:
                ok = False
                err = (r.stderr or r.stdout).strip().splitlines()
                print(f"  ✗ {i:>3} {CATEGORY[a.kind]}: {a.label} — {err[-1] if err else 'failed'}")
                break
        if ok:
            print(f"  ✓ {i:>3} {CATEGORY[a.kind]}: {a.label}")
        else:
            failures += 1
    return failures, skipped


# ----------------------------------------------------------------------------- main

def parse_args(argv):
    p = argparse.ArgumentParser(prog="cleanup", description=__doc__.split("\n\n")[0],
                                formatter_class=argparse.RawDescriptionHelpFormatter,
                                epilog=__doc__.split("\n\n", 1)[1])
    p.add_argument("-y", "--y", "--yes", dest="yes", action="store_true",
                   help="do not ask; remove everything in the plan")
    p.add_argument("--dry-run", action="store_true", help="show the plan and exit")
    p.add_argument("--all", action="store_true", help="list every item (no grouping)")
    p.add_argument("--stale-days", type=int, default=14, help="stack idle threshold (default 14)")
    p.add_argument("--stopped-hours", type=int, default=24,
                   help="stopped-container threshold (default 24)")
    p.add_argument("--image-days", type=int, default=7, help="unused-image age (default 7)")
    p.add_argument("--cache-keep-gb", type=int, default=10,
                   help="build cache to keep, most recently used first (default 10 GB)")
    p.add_argument("--keep-stacks", action="store_true", help="never remove compose stacks")
    p.add_argument("--volumes", action="store_true",
                   help="also remove named volumes of stale stacks (orphaned stacks always)")
    p.add_argument("--caches", action="store_true",
                   help="also empty npm/uv caches and old Playwright browsers")
    p.add_argument("--deps", action="store_true",
                   help="also remove dependency dirs in idle git worktrees (root only)")
    p.add_argument("--deps-days", type=int, default=14,
                   help="worktree idle threshold for --deps (default 14)")
    p.add_argument("--deps-roots", default=",".join(DEPS_ROOTS),
                   help=f"comma-separated dirs searched for worktrees (default {','.join(DEPS_ROOTS)})")
    p.add_argument("--worktrees", action="store_true",
                   help="also remove whole linked git worktrees that are clean and merged or "
                        "stale (root only)")
    p.add_argument("--worktree-days", type=int, default=30,
                   help="idle threshold for a clean worktree whose HEAD is on a remote (default 30)")
    p.add_argument("--merged-days", type=int, default=3,
                   help="idle threshold for a clean worktree already merged (default 3)")
    p.add_argument("--no-docker", action="store_true",
                   help="skip every docker category (docker is still asked which paths running "
                        "containers mount, when --deps or --worktrees runs)")
    return p.parse_args(argv)


LOCK = "/run/lock/dev-worker-cleanup.lock"


def take_lock():
    """One removing run at a time (the timer and a hand-run `sudo cleanup --deps`)."""
    import fcntl  # Linux only; imported here so the tests import this file anywhere
    f = open(LOCK, "w")
    try:
        fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        f.close()
        return None
    return f


def main(argv=None):
    args = parse_args(sys.argv[1:] if argv is None else argv)
    docker = not args.no_docker
    if docker and not shutil.which("docker"):
        print("cleanup: docker not found (use --no-docker)", file=sys.stderr)
        return 2
    walk = args.deps or args.worktrees
    if not docker and not walk:
        print("cleanup: --no-docker leaves nothing to do without --deps or --worktrees",
              file=sys.stderr)
        return 2
    if min(args.deps_days, args.worktree_days, args.merged_days) < 1 \
            or args.merged_days > args.worktree_days:
        print("cleanup: day thresholds must be >= 1, and --merged-days <= --worktree-days",
              file=sys.stderr)
        return 2
    if walk and not args.dry_run and os.geteuid() != 0:
        # Without root, /proc hides other users' processes, so "nothing is using it" is unknowable.
        print("cleanup: --deps and --worktrees remove only as root (sudo cleanup --deps); "
              "--dry-run works as any user", file=sys.stderr)
        return 2
    lock = None
    if not args.dry_run and os.geteuid() == 0:
        lock = take_lock()
        if lock is None:
            print("cleanup: another cleanup run holds " + LOCK, file=sys.stderr)
            return 1
    opts = Options(args.stale_days, args.stopped_hours, args.image_days, args.cache_keep_gb,
                   args.keep_stacks, args.volumes, args.caches)
    deps_roots = [r for r in args.deps_roots.split(",") if r]
    root = docker_root() if docker else None
    watched = []
    seen = set()
    for p in ["/"] + ([root] if root else []) + (deps_roots if walk else []):
        try:
            dev = os.stat(p).st_dev
        except OSError:
            continue
        if dev not in seen:                 # one line per filesystem: /home is usually on /
            seen.add(dev)
            watched.append(p)
    print(f"cleanup on {os.uname().nodename}   disk: " + "   ".join(map(disk_line, watched)))
    if args.worktrees and os.geteuid() != 0:
        print("Not root: other users' processes are invisible, so the in-use check is partial, and "
              "only your own worktrees are judged.")
    boots = boot_times() if docker else ()
    excluded = container_roots() if walk else set()

    def scan():
        plan, refused, kept = [], [], []
        if docker:
            print("Scanning docker state…", flush=True)
            plan += build_plan(load_containers(), load_images(), load_volumes(), build_cache_bytes(),
                               load_tool_caches() if opts.caches else [], opts,
                               datetime.now(timezone.utc), boot_times=boots)
        if walk:
            print(f"Scanning git worktrees under {', '.join(deps_roots)}…", flush=True)
            now = datetime.now(timezone.utc)
            busy, binds, mounts = busy_paths(), bind_mount_sources(), mount_points()
            going = set()
            if args.worktrees:
                wplan, kept = plan_worktrees(
                    load_worktrees(deps_roots, args.merged_days, now, excluded),
                    args.worktree_days, args.merged_days, now, busy, container_claims(), mounts)
                plan += wplan
                going = {a.label for a in wplan}
            if args.deps:
                found = [w for w in load_worktrees(deps_roots, args.deps_days, now, excluded)
                         if w.path not in going]  # no point pruning what goes whole
                dplan, refused = plan_deps(found, args.deps_days, now, busy, binds, mounts)
                plan += dplan
        return plan, refused, kept

    try:
        plan, refused, kept = scan()
    except RuntimeError as e:
        print(f"cleanup: {e}", file=sys.stderr)
        return 1
    for d, why in refused:
        print(f"Not touching {d}: {why}.")
    for d, why in kept:
        print(f"Kept worktree idle {args.worktree_days}+ days: {d} — {why}.")
    if not plan:
        print("Nothing to clean up.")
        return 0
    print(render(plan, shutil.get_terminal_size((140, 40)).columns, args.all))
    print(summary(plan))
    if docker and not args.caches:
        print("Tool caches (npm, uv, old Playwright browsers) are not included; add --caches.")
    if args.dry_run:
        return 0
    interactive = sys.stdin.isatty()
    if not args.yes and not interactive:
        print("Not a terminal and no --y: nothing removed.", file=sys.stderr)
        return 1
    if not confirm(args.yes, interactive, lambda: input(f"Remove the {len(plan)} items above? [y/N] ")):
        print("Aborted. Nothing removed.")
        return 0
    before = {p: shutil.disk_usage(p).used for p in watched}
    try:
        fresh, _, _ = scan()
    except RuntimeError as e:
        print(f"cleanup: {e}", file=sys.stderr)
        return 1
    failures, skipped = execute(plan, fresh, args.deps_days, args.worktree_days,
                                args.merged_days)
    freed = sum(before[p] - shutil.disk_usage(p).used for p in watched)
    print(f"Done: {len(plan) - failures - skipped} ok, {failures} failed, {skipped} skipped. "
          f"Freed {fmt_size(max(freed, 0))}.")
    print("disk: " + "   ".join(map(disk_line, watched)))
    return 1 if failures else 0


if __name__ == "__main__":
    sys.exit(main())
