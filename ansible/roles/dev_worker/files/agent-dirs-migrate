#!/usr/bin/env bash
# agent-dirs-migrate HOME WORKSPACE_ROOT — move a user's ~/.cache and ~/.npm onto the workspace disk
# and leave symlinks behind, so every tool that writes to the default locations (uv, pip, npm/npx,
# Playwright, go, …) writes to /workspace instead of the 40 GB root disk — whatever started it: a
# login shell, a tmux pane, cron, sudo or a service. plans/2026-10-09-dev-worker-disk-hardening-plan.md W4.
#
# Run AS THE USER (tasks/agent_dirs.yml: become_user). Idempotent: a symlink already pointing at the
# target is left alone; a symlink pointing elsewhere, or a non-directory, is reported and skipped.
# Caches are regenerable, so they are NOT copied — they repopulate — except Playwright's browsers,
# which tests cannot run without and which take minutes to re-download: those are copied first.
# Skips the whole run (reporting "busy") while anything of this user uses the caches — a process
# whose cwd, executable, open file or memory mapping is under ~/.cache or ~/.npm (whatever its command
# line: `python -m pip`, `node .../playwright/cli.js`, a browser) — or while a package tool runs by
# name; the next run retries. The check runs again right before each switch (the browser copy can
# take minutes). A tool can still start between that check and the rename — nothing short of a lock
# every tool honours rules it out — so the renamed old tree is removed only once nothing references
# it: until then it is kept, the tool keeps its files, and a later run removes it.
# DW_AGENT_DIRS_BUSY_CHECK=0 disables all of these checks (tests of the move itself).
#
# Prints "moved <path>" / "removed <path>" for each change (ansible's changed_when), "skip …" for
# anything left alone, "kept …" for an old tree still in use.
set -euo pipefail

home=${1:?usage: agent-dirs-migrate HOME WORKSPACE_ROOT}
root=${2:?usage: agent-dirs-migrate HOME WORKSPACE_ROOT}
[ -d "$root" ] || { echo "skip: $root does not exist"; exit 0; }

# For the by-NAME heuristic only (the identity check below needs no namespace logic): a process in
# another mount namespace — a container's, whose uid 1000 is this user's — usually sees its own
# filesystem; a containerised Playwright under /home/appuser/.cache never touches this ~/.cache (its
# NAME blocked dev-worker-3 forever, 2026-10-09). Another namespace is not proof (`unshare -m`, a
# sandboxed service), so a name match is ignored only when the process is PROVEN isolated: its root is
# readable and neither cache path under it is the same file as ours. Anything unprovable counts.
self_ns=$(readlink /proc/self/ns/mnt)
# The checks below judge other processes against THIS process's view; run from a sandboxed unit or a
# container (a namespace of its own), every host process would look isolated. Refuse rather than
# judge from the wrong place (under ssh/ansible the parent shares the namespace).
if [ "${DW_AGENT_DIRS_BUSY_CHECK:-1}" != 0 ] && [ "$(readlink "/proc/$PPID/ns/mnt" 2>/dev/null)" != "$self_ns" ]; then
	echo "skip: busy (not running in the caller's mount namespace; cannot judge which processes use the caches)"
	exit 0
fi
relevant() { # PID: could this process be using our caches?
	local pid=$1 d id
	[ "$(readlink "/proc/$pid/ns/mnt" 2>/dev/null)" = "$self_ns" ] && return 0
	[ -r "/proc/$pid/root/" ] || return 0 # cannot look inside: assume it can
	for d in .cache .npm; do
		id=$(stat -Lc '%d:%i' "/proc/$pid/root$home/$d" 2>/dev/null) || continue
		grep -qxF -- "$id" <<<"$cache_ids" && return 0
	done
	return 1
}

# Identity, not paths: "dev:ino" of every object in the caches (one walk, one filesystem each), and of
# every object each process of this user references — cwd, executable, every open fd, every mapped
# file (/proc/PID/maps carries the device and inode) — in ANY namespace: a container, an `unshare -m`
# sandbox or a private ~/.cache with the host's ~/.cache/uv bind-mounted into it all reference the
# same objects if they use our caches, whatever path they see them under.
tree_objects() { # DIR...
	find "$@" -xdev -printf '%D:%i\n' 2>/dev/null | sort -u
}
process_objects() {
	local p dev ino maj min
	for p in /proc/[0-9]*; do
		[ -O "$p" ] || continue
		stat -Lc '%d:%i' "$p/cwd" "$p/exe" "$p"/fd/* 2>/dev/null
		while read -r _ _ _ dev ino _; do
			[ -n "$ino" ] && [ "$ino" != 0 ] || continue
			maj=$((16#${dev%%:*}))
			min=$((16#${dev##*:}))
			echo "$(((min & 255) | (maj << 8) | ((min >> 8) << 20))):$ino"
		done 2>/dev/null <"$p/maps"
	done | sort -u
}
# Processes of this user that cannot be inspected at all (not dumpable: sshd sessions, systemd --user,
# (sd-pam), some container inits — dev-worker-3, 2026-10-09). Counting them all as busy would block
# the move whenever anyone is logged in; ignoring them all would miss a non-dumpable tool. So: busy
# only when its name (comm, always readable) is a cache-using tool.
uninspectable_tool() {
	local p comm
	for p in /proc/[0-9]*; do
		[ -O "$p" ] || continue
		head -c1 "$p/maps" >/dev/null 2>&1 && continue
		read -r comm 2>/dev/null <"$p/comm" || continue
		case "$comm" in
		uv | uvx | pip | pip3 | npm | npx | pnpm | node | python | python3* | playwright* | chrom* | headless_shell | firefox* | WebKit*) return 0 ;;
		esac
	done
	return 1
}
in_use() { # DIR...: does a process of this user reference anything under DIR?
	local objs
	objs=$(tree_objects "$@")
	[ -n "$objs" ] || return 1
	[ -n "$(comm -12 <(printf '%s\n' "$objs") <(process_objects) | head -1)" ] || uninspectable_tool
}

# A running container with a bind mount at, under or ABOVE one of the caches ($HOME, /home, /): moving
# the directory would pull it from under the container. Path-component boundaries: /home/c4/.cachex
# is not /home/c4/.cache.
overlaps_caches() { # MOUNT_SOURCE
	local src=${1%/} c
	[ -n "$src" ] || return 0 # "/"
	for c in "$home/.cache" "$home/.npm"; do
		case "$c/" in "$src"/*) return 0 ;; esac # the source is c or an ancestor of it
		case "$src/" in "$c"/*) return 0 ;; esac # the source is under c
	done
	return 1
}
# 0 = a container mounts them, 1 = none does, 2 = docker could not be asked (callers treat it as busy:
# a daemon that is down or a socket this user cannot open must not read as "no containers").
containers_mount_caches() {
	local ids mounts src
	command -v docker >/dev/null 2>&1 || return 1
	ids=$(timeout 30 docker ps -q 2>/dev/null) || return 2
	[ -n "$ids" ] || return 1
	# shellcheck disable=SC2086 # one id per word
	mounts=$(timeout 60 docker inspect --format '{{range .Mounts}}{{.Source}}{{"\n"}}{{end}}' $ids 2>/dev/null) || return 2
	while IFS= read -r src; do
		[ -n "$src" ] && overlaps_caches "$src" && return 0
	done <<<"$mounts"
	return 1
}

# Prints why the caches are busy and returns 0; returns 1 when they are not.
busy() {
	local pid rc=0
	[ "${DW_AGENT_DIRS_BUSY_CHECK:-1}" != 0 ] || return 1
	cache_ids=$(stat -Lc '%d:%i' "$home/.cache" "$home/.npm" 2>/dev/null || :) # for relevant()
	if in_use "$home/.cache/" "$home/.npm/"; then
		echo "a process of $(id -un) is using $home/.cache or $home/.npm"
		return 0
	fi
	for pid in $(pgrep -u "$(id -u)" -f -- '(^|[ /])(uv|uvx|pip3?|npm|npx|pnpm)( |$)|-m (pip|uv)( |$)|playwright(/| |$)|ms-playwright/'); do
		if relevant "$pid"; then
			echo "a uv/pip/npm/playwright process of $(id -un) is running"
			return 0
		fi
	done
	containers_mount_caches || rc=$?
	case $rc in
	0) echo "a running container bind-mounts $home/.cache or $home/.npm" ;;
	2) echo "cannot ask docker which containers mount $home/.cache or $home/.npm" ;;
	*) return 1 ;;
	esac
}

# Remove SRC's renamed old tree unless a process still references it (a tool that started after the
# last busy check keeps its files; a later run removes the tree). 0 = nothing is left of it.
drop_old() { # SRC
	local old=$1.pre-workspace
	[ -e "$old" ] || return 0
	if [ "${DW_AGENT_DIRS_BUSY_CHECK:-1}" != 0 ] && in_use "$old/"; then
		echo "kept $old: still in use; a later run removes it"
		return 1
	fi
	if ! rm -rf -- "$old"; then
		echo "skip: could not fully remove $old"
		return 1
	fi
}

if why=$(busy); then
	echo "skip: busy ($why)"
	exit 0
fi

for name in .cache .npm; do
	src="$home/$name"
	dst="$root/$name"
	mkdir -p "$dst"
	if [ -L "$src" ]; then
		if [ "$(readlink -f -- "$src")" = "$(readlink -f -- "$dst")" ]; then
			if [ -e "$src.pre-workspace" ] && drop_old "$src"; then
				echo "removed $src.pre-workspace (kept by an earlier run while in use)"
			fi
			continue
		fi
		echo "skip $src: a symlink to $(readlink -- "$src"), not $dst"
		continue
	fi
	if [ -e "$src" ] && [ ! -d "$src" ]; then
		echo "skip $src: not a directory"
		continue
	fi
	if [ -d "$src" ]; then
		if ! drop_old "$src"; then # an old tree a tool still uses: never rename onto it
			echo "skip $src: $src.pre-workspace from an earlier run is still there"
			continue
		fi
		if [ "$name" = .cache ] && [ -d "$src/ms-playwright" ] && [ ! -e "$dst/ms-playwright" ]; then
			rm -rf -- "$dst/ms-playwright.partial"
			cp -a -- "$src/ms-playwright" "$dst/ms-playwright.partial"
			mv -- "$dst/ms-playwright.partial" "$dst/ms-playwright"
		fi
		# Again right before the switch: the copy above can take minutes.
		if why=$(busy); then
			echo "skip: busy ($why)"
			exit 0
		fi
		mv -T -- "$src" "$src.pre-workspace"
	fi
	# -T: if a tool recreated $src between the rename and here, fail instead of putting the link
	# INSIDE the new directory; the next run retries.
	if ! err=$(ln -sT -- "$dst" "$src" 2>&1); then
		drop_old "$src" || :
		echo "skip $src: could not link it to $dst ($err); the next run retries"
		continue
	fi
	drop_old "$src" || :
	echo "moved $src -> $dst"
done
