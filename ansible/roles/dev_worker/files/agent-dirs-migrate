#!/usr/bin/env bash
# agent-dirs-migrate HOME WORKSPACE_ROOT — move a user's ~/.cache and ~/.npm onto the workspace disk
# and leave symlinks behind, so every tool that writes to the default locations (uv, pip, npm/npx,
# Playwright, go, …) writes to /workspace instead of the 40 GB root disk — whatever started it: a
# login shell, a tmux pane, cron, sudo or a service. plans/2026-10-09-dev-worker-disk-hardening-plan.md W4.
#
# Run AS THE USER (tasks/agent_dirs.yml: become_user). Idempotent: a symlink already pointing at the
# target is left alone; a symlink pointing elsewhere, or a non-directory, is reported and skipped.
# Caches are regenerable, so they are NOT copied — they repopulate — except Playwright's browsers,
# which tests cannot run without and which take minutes to re-download: those are copied first.
# Skips the whole run (reporting "busy") while anything of this user uses the caches — a process
# whose cwd, executable, open file or memory mapping is under ~/.cache or ~/.npm (whatever its command
# line: `python -m pip`, `node .../playwright/cli.js`, a browser) — or while a package tool runs by
# name; the next run retries. DW_AGENT_DIRS_BUSY_CHECK=0 disables both (tests of the move itself).
#
# Prints "moved <path>" for each change (ansible's changed_when), "skip …" for anything left alone.
set -euo pipefail

home=${1:?usage: agent-dirs-migrate HOME WORKSPACE_ROOT}
root=${2:?usage: agent-dirs-migrate HOME WORKSPACE_ROOT}
[ -d "$root" ] || { echo "skip: $root does not exist"; exit 0; }

# A process in another mount namespace — a container's, whose uid 1000 is this user's — usually sees
# its own filesystem: a containerised Playwright under /home/appuser/.cache never touches this
# ~/.cache (it blocked dev-worker-3 forever, 2026-10-09). But another namespace is not proof (`unshare
# -m`, a sandboxed service still see the host home), so such a process is excluded only when it is
# PROVEN isolated: its root is readable and neither cache path under it is the same file as ours.
# Anything unprovable counts, conservatively.
self_ns=$(readlink /proc/self/ns/mnt)
# The checks below judge other processes against THIS process's view; run from a sandboxed unit or a
# container (a namespace of its own), every host process would look isolated. Refuse rather than
# judge from the wrong place (under ssh/ansible the parent shares the namespace).
if [ "${DW_AGENT_DIRS_BUSY_CHECK:-1}" != 0 ] && [ "$(readlink "/proc/$PPID/ns/mnt" 2>/dev/null)" != "$self_ns" ]; then
	echo "skip: busy (not running in the caller's mount namespace; cannot judge which processes use the caches)"
	exit 0
fi
cache_ids=$(stat -Lc '%d:%i' "$home/.cache" "$home/.npm" 2>/dev/null || :)
relevant() { # PID: could this process be using our caches?
	local pid=$1 d id
	[ "$(readlink "/proc/$pid/ns/mnt" 2>/dev/null)" = "$self_ns" ] && return 0
	[ -r "/proc/$pid/root/" ] || return 0 # cannot look inside: assume it can
	for d in .cache .npm; do
		id=$(stat -Lc '%d:%i' "/proc/$pid/root$home/$d" 2>/dev/null) || continue
		grep -qxF -- "$id" <<<"$cache_ids" && return 0
	done
	return 1
}

# Any relevant process of this user (the effective uid owns its /proc entry) with its cwd, executable,
# an open file or a mapping under one of the caches.
caches_in_use() {
	local p link target
	for p in /proc/[0-9]*; do
		[ -O "$p" ] || continue
		relevant "${p#/proc/}" || continue
		for link in "$p/cwd" "$p/exe" "$p"/fd/*; do
			target=$(readlink -- "$link" 2>/dev/null) || continue
			case "$target" in
			"$home/.cache" | "$home/.cache/"* | "$home/.npm" | "$home/.npm/"*) return 0 ;;
			esac
		done
		grep -qsF -e "$home/.cache/" -e "$home/.npm/" "$p/maps" && return 0
	done
	return 1
}

# A running container with a bind mount at, under or ABOVE one of the caches ($HOME, /home, /): moving
# the directory would pull it from under the container. Path-component boundaries: /home/c4/.cachex
# is not /home/c4/.cache.
overlaps_caches() { # MOUNT_SOURCE
	local src=${1%/} c
	[ -n "$src" ] || return 0 # "/"
	for c in "$home/.cache" "$home/.npm"; do
		case "$c/" in "$src"/*) return 0 ;; esac # the source is c or an ancestor of it
		case "$src/" in "$c"/*) return 0 ;; esac # the source is under c
	done
	return 1
}
# 0 = a container mounts them, 1 = none does, 2 = docker could not be asked (callers treat it as busy:
# a daemon that is down or a socket this user cannot open must not read as "no containers").
containers_mount_caches() {
	local ids mounts src
	command -v docker >/dev/null 2>&1 || return 1
	ids=$(timeout 30 docker ps -q 2>/dev/null) || return 2
	[ -n "$ids" ] || return 1
	# shellcheck disable=SC2086 # one id per word
	mounts=$(timeout 60 docker inspect --format '{{range .Mounts}}{{.Source}}{{"\n"}}{{end}}' $ids 2>/dev/null) || return 2
	while IFS= read -r src; do
		[ -n "$src" ] && overlaps_caches "$src" && return 0
	done <<<"$mounts"
	return 1
}

if [ "${DW_AGENT_DIRS_BUSY_CHECK:-1}" != 0 ]; then
	if caches_in_use; then
		echo "skip: busy (a process of $(id -un) is using $home/.cache or $home/.npm)"
		exit 0
	fi
	for pid in $(pgrep -u "$(id -u)" -f -- '(^|[ /])(uv|uvx|pip3?|npm|npx|pnpm)( |$)|-m (pip|uv)( |$)|playwright(/| |$)|ms-playwright/'); do
		if relevant "$pid"; then
			echo "skip: busy (a uv/pip/npm/playwright process of $(id -un) is running)"
			exit 0
		fi
	done
	rc=0
	containers_mount_caches || rc=$?
	if [ "$rc" = 0 ]; then
		echo "skip: busy (a running container bind-mounts $home/.cache or $home/.npm)"
		exit 0
	elif [ "$rc" = 2 ]; then
		echo "skip: busy (cannot ask docker which containers mount $home/.cache or $home/.npm)"
		exit 0
	fi
fi

for name in .cache .npm; do
	src="$home/$name"
	dst="$root/$name"
	mkdir -p "$dst"
	if [ -L "$src" ]; then
		if [ "$(readlink -f -- "$src")" = "$(readlink -f -- "$dst")" ]; then
			continue
		fi
		echo "skip $src: a symlink to $(readlink -- "$src"), not $dst"
		continue
	fi
	if [ -e "$src" ] && [ ! -d "$src" ]; then
		echo "skip $src: not a directory"
		continue
	fi
	if [ -d "$src" ]; then
		if [ "$name" = .cache ] && [ -d "$src/ms-playwright" ] && [ ! -e "$dst/ms-playwright" ]; then
			rm -rf -- "$dst/ms-playwright.partial"
			cp -a -- "$src/ms-playwright" "$dst/ms-playwright.partial"
			mv -- "$dst/ms-playwright.partial" "$dst/ms-playwright"
		fi
		mv -- "$src" "$src.pre-workspace"
	fi
	ln -s -- "$dst" "$src"
	rm -rf -- "$src.pre-workspace" || echo "skip: could not fully remove $src.pre-workspace"
	echo "moved $src -> $dst"
done
