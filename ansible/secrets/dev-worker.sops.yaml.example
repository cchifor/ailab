# Template for ansible/secrets/dev-worker.sops.yaml (the real file is SOPS-encrypted + committed).
# Only needed if you enable a secret-backed feature (restic / cloudflared / password auth) in
# group_vars/dev_workers.yml. To create the encrypted file:
#
#   cp ansible/secrets/dev-worker.sops.yaml.example ansible/secrets/dev-worker.sops.yaml
#   # edit the values below, then encrypt in place (uses the .sops.yaml dev-worker creation_rule):
#   sops --encrypt --in-place ansible/secrets/dev-worker.sops.yaml
#   git add ansible/secrets/dev-worker.sops.yaml
#
# The values are decrypted at play time by dev-workers.yml's pre_task (community.sops.load_vars).

# restic repo encryption password (when dev_worker_enable_restic: true)
dev_worker_restic_password: "CHANGE-ME-strong-random"

# Cloudflare tunnel token (when dev_worker_enable_cloudflared: true)
dev_worker_cf_tunnel_token: ""

# c4 SSH/login password (when dev_worker_enable_password_auth: true)
dev_worker_admin_password: ""

# No Gitea token here: forge credentials come from OpenBao (roles/dev_worker/tasks/openbao.yml).

# ---- web terminal gate (ALWAYS required with ttyd on — roles/dev_worker/tasks/web_gate.yml) ----
# The LAN/Tailscale login for https://192.168.0.N (user c4). ONE credential for the fleet. The play
# refuses to touch Caddy without all three. Mint: a random password (>= 16 chars), its bcrypt
# (`caddy hash-password`, or python bcrypt with prefix 2a), and 64 hex chars for the cookie
# (`openssl rand -hex 32`). The cookie is a bearer credential equal to the password and does not
# expire server-side: rotate BOTH together (runbook § "Remote access (web terminals)").
dev_worker_web_lan_password: "CHANGE-ME-random-24+"
dev_worker_web_lan_password_bcrypt: "$2a$14$CHANGE-ME"
dev_worker_web_lan_cookie_secret: "CHANGE-ME-64-hex"

# ---- OpenBao AppRole logins (when dev_worker_enable_openbao: true — ADR 0020) ----
# One entry per worker you enable, keyed by inventory_hostname; asserted non-empty by
# roles/dev_worker/tasks/openbao.yml. Both values are minted by the ceremony in
# docs/runbooks/openbao-dev-workers.md (`bao read auth/approle/role/dev-worker-N/role-id`,
# `bao write -f auth/approle/role/dev-worker-N/secret-id`) and exist ONLY here and in the worker's
# /etc/openbao-agent — never in a k8s Secret. The roles carry no CIDR binding (Cilium's SNAT hides
# the worker's source IP — ADR 0020), so a secret-id is a live credential usable from anywhere on the
# mgmt LAN, not a machine-bound one: treat it like a password, and destroy the old accessor when you
# re-mint. It does not expire on its own.
dev_worker_openbao_credentials:
  dev-worker-1:
    role_id: "CHANGE-ME-role-id"
    secret_id: "CHANGE-ME-secret-id"
