# testpool env-control — the toolchain half of the env pod (SandboxTemplate container "control").
# Base = the Playwright runtime image (Ubuntu jammy + node + browsers + system deps) so PW-class
# suites run host-side in-env, plus: docker CLI (copied from the pinned cli image — talks to the
# dind sidecar over the shared socket), uv (python toolchain), rsync (enables tep's delta-sync
# path), git, netcat (the tcp ready-port), jq. The workload audit's host-side needs: uv+pytest,
# node/npm (in base), playwright (in base), docker CLI, rsync, tar, git.
FROM mcr.microsoft.com/playwright:v1.61.1-jammy

COPY --from=docker.io/library/docker:28.3-cli@sha256:0135662b510037ea581d99c2e5929c5e01185139c0b86986a418bd4da0b98a44 \
     /usr/local/bin/docker /usr/local/bin/docker
COPY --from=ghcr.io/astral-sh/uv:0.8.15 /uv /uvx /usr/local/bin/

RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      rsync git jq netcat-openbsd python3 python3-venv ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*
