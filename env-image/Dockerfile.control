# testpool env-control — the toolchain half of the env pod (SandboxTemplate container "control").
#
# DELIBERATELY NOT the mcr.microsoft.com/playwright image (~2 GB: all three browser engines baked
# for ONE playwright version). Repos pin different playwright versions and the npm package must
# match the browser build — so browsers live in the GOLDEN VOLUME instead
# (PLAYWRIGHT_BROWSERS_PATH=/data/caches/ms-playwright, set in the SandboxTemplate): version-correct
# per repo, warm after first use, snapshot-persisted, array-side CoW-shared across leases. This
# image carries only what is version-STABLE: node, the playwright SYSTEM libraries
# (install-deps), docker CLI, uv, rsync, git, jq. ~700 MB instead of ~2 GB.
# The CI-container lane (docker run mcr.microsoft.com/playwright ...) is unaffected — that image
# stays in hack/golden-images.txt as a docker-cache entry.
FROM docker.io/library/node:22-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5

COPY --from=docker.io/library/docker:29.7-cli@sha256:3f4743208d2338c934d7b8bcfbe1bb54c0b2355c510ad5e0f31c0c4a54bd704e \
     /usr/local/bin/docker /usr/local/bin/docker
COPY --from=ghcr.io/astral-sh/uv:0.8.15 /uv /uvx /usr/local/bin/

RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      rsync git jq netcat-openbsd python3 python3-venv ca-certificates curl \
 # Playwright SYSTEM deps only (no browsers): version-stable apt libraries for chromium/firefox/
 # webkit; the browsers themselves install per-repo-version into PLAYWRIGHT_BROWSERS_PATH.
 && npx -y playwright@1.61.1 install-deps \
 && rm -rf /var/lib/apt/lists/* /root/.npm
