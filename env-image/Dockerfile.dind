# testpool env-dind — the DinD half of the env pod (SandboxTemplate container "dind").
# Upstream docker:dind + the guest-side storage tooling baked (kills the runtime `apk add`
# observed at ~3 s/lease in the spikes). Everything else about the dind container (block mount,
# iptables-legacy entrypoint wrapper, overlay2 assertion) stays in the SandboxTemplate args.
FROM docker.io/library/docker:29.8-dind@sha256:7dcdfc4a20246236f558175182ccace1eb15a41bd3eb119dd2284f393498b7c1
RUN apk add --no-cache e2fsprogs
