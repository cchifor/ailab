 # Dev-worker AppRole provisioning (ADR 0020) — the declarative half of giving each dev-worker VM its
 # own OpenBao identity. Enables the `approle` auth mount, writes one read-only policy + one AppRole
 # role per worker (PERIODIC tokens, so a renewing agent never hits the max-TTL cliff that locked the
-# estate out on 2026-08-25), and seed-patches the af/dev-workers/* KV paths from the
+# estate out on 2026-08-25) — and, since 2026-09-12, the same shape for the two reviewer VMs, whose
+# only grant is the shared codex OAuth read (below) — and seed-patches the af/dev-workers/* KV paths from the
 # openbao-devworker-seeds Secret (SEED-WINS contract — a key present in the seed overwrites live KV
 # on every daily run). NB: that is the contract of THIS Job and of estate-provision-job.yaml, and it
 # is NOT the AgentForge operator seed's — provision-job.yaml's `_apply_operator_seeds` is
@@ -59,6 +60,17 @@ data:
       bao auth enable approle
     fi
 
+    # ONE codex login for the whole estate (2026-09-12). The Codex Pro OAuth document the broker uses
+    # (af/operator/broker/openai/codex-pro/oauth, rotated by the af-codex-refresh CronJob) is ALSO
+    # what every dev worker and reviewer VM renders its ~/.codex/auth.json from — the bao agent
+    # template strips the refresh_token, so a host holds an access token it can use but can never
+    # rotate. That is the whole point: OpenAI refresh tokens are single-use, so two copies of one
+    # login that both refresh revoke the entire family (which is how every host + the broker lost
+    # codex on 2026-09-03). The CronJob is the ONLY refresher; hosts are read-only consumers.
+    # `read` on the DATA path only — no metadata, no list, no write — so a host can neither see the
+    # rotation history nor race the CronJob's CAS write.
+    CODEX_OAUTH_GRANT='path "af/data/operator/broker/openai/codex-pro/oauth" { capabilities = ["read"] }'
+
     # The six dev workers (inventory/hosts.yml, group dev_workers). Role and policy are both named
     # after the ansible inventory_hostname, so an audit entry names the machine. Adding a worker is
     # one word here plus the mint ceremony in docs/runbooks/openbao-dev-workers.md.
@@ -67,6 +79,7 @@ data:
       # grants are what make `cred list` work; nothing here can create, update or delete, so a
       # compromised worker cannot rewrite another worker's credentials.
       bao policy write "$host" - <<EOF
+    ${CODEX_OAUTH_GRANT}
     path "af/data/dev-workers/common"        { capabilities = ["read"] }
     path "af/data/dev-workers/common/*"      { capabilities = ["read"] }
     path "af/data/dev-workers/${host}"       { capabilities = ["read"] }
@@ -92,6 +105,21 @@ data:
         secret_id_num_uses=0
     done
 
+    # The two reviewer VMs (inventory/hosts.yml, group reviewers; ansible/reviewers.yml). Same
+    # AppRole shape as a dev worker, but the policy is the codex OAuth read and NOTHING else: a
+    # reviewer has no `cred`, no per-host subtree, and must not see the dev-workers KV (gitea PAT,
+    # hypervisor key). The mint ceremony is the same one — docs/runbooks/openbao-dev-workers.md (e).
+    for host in reviewer-1 reviewer-2; do
+      bao policy write "$host" - <<EOF
+    ${CODEX_OAUTH_GRANT}
+    EOF
+      bao write "auth/approle/role/${host}" \
+        token_policies="${host}" \
+        token_period=72h \
+        secret_id_ttl=0 \
+        secret_id_num_uses=0
+    done
